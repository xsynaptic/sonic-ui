{
	"name": "sonic-ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Custom elements for audio interfaces on the web",
	"author": "Alexander Synaptic <x@synapticism.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xsynaptic/sonic-ui.git"
	},
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"prepare": "pnpm --filter './packages/*' build",
		"build": "pnpm --filter './packages/*' build",
		"dev": "FORCE_COLOR=1 pnpm --recursive --parallel dev",
		"check-types": "tsc --noEmit && pnpm --recursive check-types",
		"test": "pnpm build && vitest run",
		"test-e2e": "pnpm build && pnpm -F @playground/sonic-ui test-e2e",
		"test-e2e-full": "pnpm build && pnpm -F @playground/sonic-ui test-e2e-full",
		"stryker-file": "stryker run --mutate",
		"stryker-confirm": "stryker run --concurrency 2 --mutate",
		"mutant-diff": "node scripts/mutant-diff.ts",
		"capture": "pnpm build && pnpm -F @playground/sonic-ui capture",
		"changeset": "changeset",
		"check": "lefthook run check",
		"check-pkg": "pnpm --filter './packages/*' --no-bail exec publint",
		"fix": "lefthook run fix",
		"release": "node scripts/release.ts"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@fast-check/vitest": "^0.5.0",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@xsynaptic/eslint-config": "^6.8.0",
		"@xsynaptic/stylelint-config": "^1.1.6",
		"autoprefixer": "^10.6.2",
		"eslint": "^10.14.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"fallow": "^3.40.0",
		"fast-check": "^4.10.2",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"knip": "^6.44.1",
		"lefthook": "^2.2.2",
		"postcss": "^8.5.32",
		"postcss-nesting": "^14.0.3",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"stylelint": "^17.16.0",
		"stylelint-plugin-use-baseline": "^1.4.8",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	}
}
