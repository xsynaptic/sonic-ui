{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "pnpm",
	"testRunner": "vitest",
	"plugins": ["@stryker-mutator/vitest-runner"],
	"coverageAnalysis": "perTest",
	"warnings": { "slow": false },
	"mutate": ["packages/sonic-ui/src/lib/**/*.ts"],
	"ignorePatterns": [
		"**",
		"!package.json",
		"!pnpm-workspace.yaml",
		"!tsconfig.json",
		"!tsconfig.base.json",
		"!vitest.config.ts",
		"!packages/sonic-ui/**",
		"packages/sonic-ui/node_modules/**"
	],
	"tempDirName": ".cache/stryker-tmp",
	"timeoutMS": 20000,
	"reporters": ["clear-text"],
	"clearTextReporter": { "allowColor": false, "maxTestsToLog": 2 }
}
