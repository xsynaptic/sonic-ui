{
	"name": "@xsynaptic/sonic-ui",
	"version": "0.21.0",
	"description": "Native custom elements for audio interfaces, skinned with CSS custom properties",
	"keywords": [
		"custom-elements",
		"web-components",
		"audio",
		"dial",
		"slider",
		"synth"
	],
	"homepage": "https://github.com/xsynaptic/sonic-ui#readme",
	"bugs": {
		"url": "https://github.com/xsynaptic/sonic-ui/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xsynaptic/sonic-ui.git",
		"directory": "packages/sonic-ui"
	},
	"license": "MIT",
	"author": "Alexander Synaptic <x@synapticism.com>",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"sideEffects": [
		"./dist/*/define.js",
		"./dist/*/define/*.js",
		"./src/define.ts",
		"./src/define/*.ts",
		"*.css"
	],
	"exports": {
		".": {
			"types": "./dist/dev/index.d.ts",
			"development": "./dist/dev/index.js",
			"import": "./dist/default/index.js"
		},
		"./define": {
			"types": "./dist/dev/define.d.ts",
			"development": "./dist/dev/define.js",
			"import": "./dist/default/define.js"
		},
		"./define/*": {
			"types": "./dist/dev/define/*.d.ts",
			"development": "./dist/dev/define/*.js",
			"import": "./dist/default/define/*.js"
		},
		"./controls.css": "./dist/styles/controls.css",
		"./material.css": "./dist/styles/material.css",
		"./material/*.css": "./dist/styles/material/*.css",
		"./button.css": "./dist/styles/button.css",
		"./dial.css": "./dist/styles/dial.css",
		"./envelope.css": "./dist/styles/envelope.css",
		"./led.css": "./dist/styles/led.css",
		"./meter.css": "./dist/styles/meter.css",
		"./number.css": "./dist/styles/number.css",
		"./panel.css": "./dist/styles/panel.css",
		"./ring.css": "./dist/styles/ring.css",
		"./screen.css": "./dist/styles/screen.css",
		"./segmented.css": "./dist/styles/segmented.css",
		"./slider.css": "./dist/styles/slider.css",
		"./spectrum.css": "./dist/styles/spectrum.css",
		"./switch.css": "./dist/styles/switch.css",
		"./toggle.css": "./dist/styles/toggle.css",
		"./waveform.css": "./dist/styles/waveform.css",
		"./wavestrip.css": "./dist/styles/wavestrip.css",
		"./xy.css": "./dist/styles/xy.css",
		"./skins/*.css": "./dist/skins/*.css"
	},
	"imports": {
		"#*": "./src/*"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"imports": {}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit"
	},
	"devDependencies": {
		"publint": "^0.3.25",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3"
	}
}
