---
import Label from '#components/replica/label.astro';
import PanelButton from '#components/replica/panel-button.astro';
import PanelDial from '#components/replica/panel-dial.astro';
import PanelSwitch from '#components/replica/panel-switch.astro';
import EchoHead from '#components/tape-echo/echo-head.astro';

const sources = [
	{ text: 'Phrase', value: 'phrase' },
	{ text: 'Mic', value: 'mic' },
	{ text: 'File', value: 'file' },
];
const cutTicks = {
	high: [1000, 2000, 5000, 10_000, 20_000],
	low: [20, 50, 100, 200, 500, 1000, 2000],
};
---

<div
	aria-label="Echo"
	class="sonic-panel [--sonic-panel-radius:1.5rem] grid grid-cols-3 items-start justify-items-center gap-x-6 gap-y-5 p-4"
	role="group"
>
	<EchoHead division="dot" head={1} ticks={36} />
	<div class="row-span-2 grid justify-items-center gap-4">
		<PanelDial
			data={{ 'data-echo-mix': '' }}
			ends={['Dry', 'Wet']}
			format="percent"
			id="echo-mix"
			label="Mix"
			max={100}
			min={0}
			size="large"
			value={35}
		/>
		<PanelDial
			data={{ 'data-echo-feedback': '' }}
			ends={['Min', 'Max']}
			format="percent"
			id="echo-feedback"
			label="Feedback"
			max={100}
			min={0}
			size="large"
			value={45}
		/>
		<PanelSwitch id="echo-offset" label="Offset" />
		<PanelButton
			data={{ 'data-echo-play': '' }}
			id="echo-play"
			isRound={true}
			label="Play"
			size="large"
		/>
		<div class="grid justify-items-center gap-1">
			<sonic-segmented
				aria-labelledby="echo-source"
				class="font-mono [--sonic-segmented-size:1.25rem]"
				data-echo-source
				value="phrase"
			>
				{sources.map((source) => (
					<span class="text-[0.5rem] uppercase" data-sonic-value={source.value}>
						{source.text}
					</span>
				))}
			</sonic-segmented>
			<Label id="echo-source" text="Source" />
			<input accept="audio/*" data-echo-file hidden type="file" />
		</div>
	</div>
	<EchoHead division="note" head={2} ticks={48} />
	<PanelDial
		data={{ 'data-echo-low-cut': '' }}
		ends={['Min', 'Max']}
		format="hertz"
		id="echo-low-cut"
		label="Low cut"
		max={2000}
		min={20}
		size="large"
		taper="log"
		ticks={cutTicks.low}
		value={120}
	/>
	<PanelDial
		data={{ 'data-echo-high-cut': '' }}
		ends={['Min', 'Max']}
		format="hertz"
		id="echo-high-cut"
		label="High cut"
		max={20_000}
		min={1000}
		size="large"
		taper="log"
		ticks={cutTicks.high}
		value={6000}
	/>
</div>
