---
import Label from '#components/replica/label.astro';
import PanelButton from '#components/replica/panel-button.astro';
import PanelDial from '#components/replica/panel-dial.astro';
import EchoHead from '#components/tape-echo/echo-head.astro';
import Panel from '#components/tape-echo/panel.astro';
import { echoModes } from '#scripts/stop-names.ts';

const feels = [
	{ data: { 'data-echo-groove': '' }, ends: ['Short', 'Long'], id: 'echo-groove', label: 'Groove' },
	{ data: { 'data-echo-feel': '' }, ends: ['Early', 'Late'], id: 'echo-feel', label: 'Feel' },
] as const;
---

<Panel id="echo-time-title" title="Time">
	<div class="flex items-end justify-center gap-6">
		<PanelButton
			data={{ 'data-echo-tap': '' }}
			id="echo-tap"
			isMomentary={true}
			label="Tap"
			size="large"
		/>
		<div class="grid content-end justify-items-center gap-1">
			<div class="sonic-screen w-fit [font-family:var(--sonic-glass-font,var(--font-mono))] [--sonic-screen-inset-ratio:0] [--sonic-screen-size:1.75rem]">
				<sonic-number
					aria-labelledby="echo-bpm"
					class="[--sonic-number-size:1.75rem]"
					data-echo-bpm
					data-format="bpm"
					default="96"
					max="250"
					min="40"
					step="0.1"
					value="96"
				></sonic-number>
			</div>
			<Label id="echo-bpm" text="Tempo" />
		</div>
	</div>
	<div class="flex items-end justify-center gap-6">
		<EchoHead division="dot" head={1} ticks={36} />
		<EchoHead division="note" head={2} ticks={48} />
	</div>
	<div class="flex items-end justify-center gap-4 [--sonic-dial-scale-font-ratio:0.14]">
		<PanelDial
			data={feels[0].data}
			detent={0}
			ends={[feels[0].ends[0], feels[0].ends[1]]}
			format="signed-percent"
			id={feels[0].id}
			label={feels[0].label}
			max={50}
			min={-50}
			origin={0}
			size="large"
			value={0}
		/>
		<div class="grid justify-items-center gap-1">
			<sonic-dial
				aria-labelledby="echo-mode"
				class="[--sonic-dial-notch-ratio:0.05] [--sonic-dial-scale-font-ratio:0.094] [--sonic-dial-scale-ratio:0.16] [--sonic-dial-size:5.5rem]"
				data-echo-mode
				data-format="echo-mode"
				max="3"
				notched
				readout
				value="1"
			>
				{echoModes.labels.map((mode, index) => (
					<span class="font-mono uppercase" data-sonic-value={index}>
						{mode}
					</span>
				))}
			</sonic-dial>
			<Label id="echo-mode" text="Mode" />
		</div>
		<PanelDial
			data={feels[1].data}
			detent={0}
			ends={[feels[1].ends[0], feels[1].ends[1]]}
			format="signed-percent"
			id={feels[1].id}
			label={feels[1].label}
			max={50}
			min={-50}
			origin={0}
			size="large"
			value={0}
		/>
	</div>
</Panel>
