---
import Label from '#components/replica/label.astro';
import PanelDial from '#components/replica/panel-dial.astro';
import Panel from '#components/tape-echo/panel.astro';
import { tapeStyles } from '#scripts/stop-names.ts';

const cutTicks = {
	high: [1000, 2000, 5000, 10_000, 20_000],
	low: [20, 50, 100, 200, 500, 1000, 2000],
};
---

<Panel id="echo-tone-title" title="Tone">
	<div class="flex items-end justify-center gap-6">
		<PanelDial
			data={{ 'data-echo-feedback': '' }}
			format="percent"
			id="echo-feedback"
			label="Feedback"
			max={100}
			min={0}
			size="large"
			value={45}
		/>
		<PanelDial
			data={{ 'data-echo-saturation': '' }}
			format="percent"
			id="echo-saturation"
			label="Saturation"
			max={100}
			min={0}
			size="large"
			value={30}
		/>
	</div>
	<div class="flex items-end justify-center gap-6">
		<PanelDial
			data={{ 'data-echo-low-cut': '' }}
			format="hertz"
			id="echo-low-cut"
			label="Low cut"
			max={2000}
			min={20}
			size="large"
			taper="log"
			ticks={cutTicks.low}
			value={120}
		/>
		<PanelDial
			data={{ 'data-echo-high-cut': '' }}
			format="hertz"
			id="echo-high-cut"
			label="High cut"
			max={20_000}
			min={1000}
			size="large"
			taper="log"
			ticks={cutTicks.high}
			value={6000}
		/>
	</div>
	<div class="flex items-end justify-center gap-6">
		<div class="grid justify-items-center gap-1">
			<div class="sonic-screen w-fit [font-family:var(--sonic-glass-font,var(--font-mono))] [--sonic-screen-inset-ratio:0] [--sonic-screen-size:1.5rem]">
				<sonic-number
					aria-labelledby="echo-style"
					class="[--sonic-number-aspect-ratio:4.5] [--sonic-number-size:1.5rem]"
					data-echo-style
					data-format="tape-style"
					positions={tapeStyles.positions}
					press="step"
					value="1"
				></sonic-number>
			</div>
			<Label id="echo-style" text="Style" />
		</div>
	</div>
</Panel>
