---
import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';
---

<Section title="Values">
	<SpecimenGrid size="large">
		<Cell id="xy-filter" isStacked={true} label="Filter">
			<div class="contents" data-xy-scope>
				<sonic-xy
					aria-labelledby="xy-filter"
					data-xy-format="hertz db"
					readout
					x="1200"
					x-label="Cutoff"
					x-max="20000"
					x-min="20"
					x-taper="log"
					y="6"
					y-label="Gain"
					y-max="24"
					y-min="-24"
					y-origin="0"
					y-step="0.5"
				></sonic-xy>
				<div
					class="sonic-screen min-w-32 font-mono text-[0.625rem] [--sonic-screen-size:1.5rem]"
					data-xy-screen
				></div>
			</div>
		</Cell>
		<Cell id="xy-bipolar" label="Pan and tilt">
			<sonic-xy
				aria-labelledby="xy-bipolar"
				x="20"
				x-default="0"
				x-max="50"
				x-min="-50"
				x-origin="0"
				y="-15"
				y-default="0"
				y-max="50"
				y-min="-50"
				y-origin="0"
			></sonic-xy>
		</Cell>
		<Cell id="xy-glass" label="Morph">
			<div class="sonic-screen">
				<sonic-xy aria-labelledby="xy-glass" readout x="30" y="60"></sonic-xy>
			</div>
		</Cell>
		<Cell id="xy-wide" label="Space">
			<sonic-xy
				aria-labelledby="xy-wide"
				class="[--sonic-xy-aspect-ratio:1.75] [--sonic-xy-size:6rem]"
				x="65"
				y="35"
			></sonic-xy>
		</Cell>
	</SpecimenGrid>
</Section>
<Section title="States">
	<SpecimenGrid size="large">
		<Cell id="xy-disabled" label="Disabled">
			<sonic-xy aria-labelledby="xy-disabled" disabled x="70" y="40"></sonic-xy>
		</Cell>
	</SpecimenGrid>
</Section>

<script>
	import '#scripts/specimens/xy.ts';
</script>
