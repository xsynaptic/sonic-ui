---
import InstrumentPanel from '#components/specimens/instrument-panel.astro';
import { tokenGroups } from '#scripts/specimens/tuner-tokens.ts';

const buttonClass =
	'rounded border border-line-strong px-2.5 py-1 font-mono text-xs text-text hover:border-text-muted hover:text-text-strong';
---

<div class="grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]" data-tuner>
	<div>
		<div data-tuner-panel>
			<InstrumentPanel />
		</div>
		{import.meta.env.DEV ? (
			<div data-tuner-tools>
				<div class="mt-3 flex flex-wrap items-center gap-3">
					<span class="font-mono text-xs text-text-muted" data-tuner-count />
					<button class={buttonClass} data-tuner-copy type="button">
						Copy CSS
					</button>
					<button class={buttonClass} data-tuner-reset type="button">
						Reset
					</button>
				</div>
				<pre
					class="mt-3 max-h-40 overflow-auto bg-surface px-4 py-3 text-[0.8125rem] select-all"
					data-tuner-output
					hidden
				/>
			</div>
		) : undefined}
	</div>
	<div class="relative self-stretch">
		<div class="overflow-y-auto overscroll-contain surface [scrollbar-color:var(--color-line-strong)_transparent] [scrollbar-width:thin] lg:absolute lg:inset-0">
			{tokenGroups.map((group, index) => (
				<details class="border-b border-line px-4 py-3 last:border-b-0" open={index === 0}>
					<summary class="cursor-pointer font-mono text-xs tracking-[0.12em] text-text uppercase">
						{group.name}
					</summary>
					<div class="mt-3 grid gap-2">
						{group.tokens.map((token) => (
							<label class="grid grid-cols-[6.5rem_minmax(0,1fr)_4.5rem] items-center gap-3 font-mono text-xs text-text-muted">
								<span>{token.label}</span>
								{token.kind === 'range' ? (
									<input
										class="w-full min-w-0"
										data-token={token.token}
										max={token.max}
										min={token.min}
										step={token.step}
										type="range"
									/>
								) : undefined}
								{token.kind === 'colour' ? (
									<input
										class="h-6 w-full cursor-pointer bg-transparent"
										data-token={token.token}
										type="color"
									/>
								) : undefined}
								{token.kind === 'choice' ? (
									<select
										class="w-full min-w-0 rounded border border-line-strong bg-surface px-1 py-0.5 text-text"
										data-token={token.token}
									>
										{token.options.map((option) => (
											<option value={option.value}>{option.label}</option>
										))}
									</select>
								) : undefined}
								<output class="truncate text-right text-text" />
							</label>
						))}
					</div>
				</details>
			))}
		</div>
	</div>
	<span aria-hidden="true" class="hidden" data-tuner-probe></span>
</div>
