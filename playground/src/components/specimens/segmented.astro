---
import Cell from '#components/specimens/cell.astro';
import FilterModes from '#components/specimens/filter-modes.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';
import TransportModes from '#components/specimens/transport-modes.astro';
---

<SpecimenGrid>
	<Cell id="segmented-filter" label="Filter mode" span="wide">
		<sonic-segmented aria-labelledby="segmented-filter" class="font-mono" value="lp">
			<FilterModes hasNotch={true} />
		</sonic-segmented>
	</Cell>
	<Cell id="segmented-transport" label="Transport" span="wide">
		<sonic-segmented aria-labelledby="segmented-transport" value="play">
			<TransportModes />
		</sonic-segmented>
	</Cell>
	<Cell id="segmented-option-disabled" label="One option disabled" span="wide">
		<sonic-segmented aria-labelledby="segmented-option-disabled" class="font-mono" value="lp">
			<span data-sonic-value="lp">LP</span>
			<span data-sonic-disabled data-sonic-value="bp">
				BP
			</span>
			<span data-sonic-value="hp">HP</span>
		</sonic-segmented>
	</Cell>
	<Cell id="segmented-disabled" label="Disabled">
		<sonic-segmented aria-labelledby="segmented-disabled" class="font-mono" disabled value="bp">
			<FilterModes hasNotch={false} />
		</sonic-segmented>
	</Cell>
</SpecimenGrid>
<SpecimenGrid size="large">
	<Cell id="segmented-large-filter" label="Filter mode, large" span="wide">
		<sonic-segmented
			aria-labelledby="segmented-large-filter"
			class="font-mono [--sonic-segmented-size:4rem]"
			value="lp"
		>
			<FilterModes hasNotch={true} />
		</sonic-segmented>
	</Cell>
	<Cell id="segmented-large-transport" label="Transport, large" span="wide">
		<sonic-segmented
			aria-labelledby="segmented-large-transport"
			class="[--sonic-segmented-size:4rem]"
			value="play"
		>
			<TransportModes />
		</sonic-segmented>
	</Cell>
</SpecimenGrid>
