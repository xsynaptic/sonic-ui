---
import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const spectrums = [
	{ id: 'spectrum-still', label: 'Master', shape: 2 },
	{ id: 'spectrum-hold', isHeld: true, label: 'Peaks', shape: 3 },
	{ grid: 'none', id: 'spectrum-bare', label: 'EQ overlay', shape: 3 },
	{ hasGlass: true, id: 'spectrum-glass', label: 'Analyser', shape: 2 },
];
---

<Section title="Frames">
	<SpecimenGrid size="wide">
		{spectrums.map((spectrum) => (
			<Cell id={spectrum.id} label={spectrum.label}>
				<div
					aria-labelledby={spectrum.id}
					class:list={[spectrum.hasGlass && 'sonic-screen']}
					role="group"
				>
					<sonic-spectrum
						class="[--sonic-spectrum-length:20rem]"
						data-spectrum-shape={spectrum.shape}
						grid={spectrum.grid}
						peak-hold={spectrum.isHeld}
					></sonic-spectrum>
				</div>
			</Cell>
		))}
	</SpecimenGrid>
</Section>

<script>
	import '#scripts/spectrum-frames.ts';
</script>
