---
import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const ladder = '-30 -25 -20 -16 -13 -10 -7 -4 0';
const ballistics = [
	{ id: 'meter-ppm-1', label: 'PPM I', mode: 'ppm-1' },
	{ id: 'meter-ppm-2', label: 'PPM II', mode: 'ppm-2' },
	{ id: 'meter-vu', label: 'VU', mode: 'vu' },
];
---

<Section title="Levels">
	<SpecimenGrid>
		<Cell id="meter-stereo" label="Master">
			<div aria-labelledby="meter-stereo" class="flex gap-1" role="group">
				<sonic-meter></sonic-meter>
				<sonic-meter></sonic-meter>
			</div>
		</Cell>
		<Cell id="meter-ladder" label="Channel">
			<div
				aria-labelledby="meter-ladder"
				class="flex gap-1 [--sonic-meter-clip-from:-4] [--sonic-meter-hot-from:-10]"
				role="group"
			>
				<sonic-meter segments={ladder}></sonic-meter>
				<sonic-meter segments={ladder}></sonic-meter>
			</div>
		</Cell>
		<Cell id="meter-horizontal" label="Output" span="wide">
			<div aria-labelledby="meter-horizontal" class="grid gap-1" role="group">
				<sonic-meter orientation="horizontal"></sonic-meter>
				<sonic-meter orientation="horizontal"></sonic-meter>
			</div>
		</Cell>
	</SpecimenGrid>
</Section>
<Section title="Values">
	<SpecimenGrid>
		<Cell id="meter-reduction" label="Reduction">
			<div aria-labelledby="meter-reduction" role="group">
				<sonic-meter data-demo="reduction" max="0" min="-24" origin="0" value="0"></sonic-meter>
			</div>
		</Cell>
		<Cell id="meter-correlation" label="Correlation" span="wide">
			<div aria-labelledby="meter-correlation" role="group">
				<sonic-meter
					data-demo="correlation"
					max="1"
					min="-1"
					orientation="horizontal"
					origin="0"
					value="0"
				></sonic-meter>
			</div>
		</Cell>
	</SpecimenGrid>
</Section>
<Section title="Ballistics">
	<SpecimenGrid>
		{ballistics.map(({ id, label, mode }) => (
			<Cell id={id} label={label}>
				<div aria-labelledby={id} role="group">
					<sonic-meter ballistics={mode} />
				</div>
			</Cell>
		))}
	</SpecimenGrid>
</Section>

<script>
	import '#scripts/specimens/motion.ts';
</script>
