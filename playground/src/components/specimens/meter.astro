---
import Play from '@lucide/astro/icons/play';

import Cell from '#components/specimens/cell.astro';
import Panel from '#components/specimens/panel.astro';

const ladder = '-30 -25 -20 -16 -13 -10 -7 -4 0';
const shortLadder = '-24 -12 -6 -3 0';
const ballistics = [
	{ id: 'meter-ppm-1', label: 'PPM I', mode: 'ppm-1' },
	{ id: 'meter-ppm-2', label: 'PPM II', mode: 'ppm-2' },
	{ id: 'meter-vu', label: 'VU', mode: 'vu' },
];
---

<Panel>
	<Cell id="meter-stereo" label="Stereo">
		<div aria-labelledby="meter-stereo" class="flex gap-1" role="group">
			<sonic-meter></sonic-meter>
			<sonic-meter></sonic-meter>
		</div>
	</Cell>
	<Cell id="meter-horizontal" isWide={true} label="Horizontal">
		<div aria-labelledby="meter-horizontal" class="grid gap-1" role="group">
			<sonic-meter orientation="horizontal"></sonic-meter>
			<sonic-meter orientation="horizontal"></sonic-meter>
		</div>
	</Cell>
	<Cell id="meter-ladder" label="Ladder">
		<div
			aria-labelledby="meter-ladder"
			class="flex gap-1 [--sonic-meter-clip-from:-4] [--sonic-meter-hot-from:-10]"
			role="group"
		>
			<sonic-meter lights={ladder}></sonic-meter>
			<sonic-meter lights={ladder}></sonic-meter>
		</div>
	</Cell>
	<Cell id="meter-reduction" label="Reduction">
		<div aria-labelledby="meter-reduction" role="group">
			<sonic-meter data-demo="reduction" max="0" min="-24" origin="0" scale="linear"></sonic-meter>
		</div>
	</Cell>
	<Cell id="meter-short-ladder" isWide={true} label="Short ladder">
		<div aria-labelledby="meter-short-ladder" class="grid gap-1" role="group">
			<sonic-meter lights={shortLadder} orientation="horizontal"></sonic-meter>
			<sonic-meter lights={shortLadder} orientation="horizontal"></sonic-meter>
		</div>
	</Cell>
	<Cell id="meter-correlation" isWide={true} label="Correlation">
		<div aria-labelledby="meter-correlation" role="group">
			<sonic-meter
				data-demo="correlation"
				max="1"
				min="-1"
				orientation="horizontal"
				origin="0"
				scale="linear"
			></sonic-meter>
		</div>
	</Cell>
	{ballistics.map(({ id, label, mode }) => (
		<Cell id={id} label={label}>
			<div aria-labelledby={id} role="group">
				<sonic-meter ballistics={mode} />
			</div>
		</Cell>
	))}
	<Cell id="meter-peak" isWide={true} label="Peak report">
		<div
			aria-labelledby="meter-peak"
			class="grid justify-items-center gap-2"
			data-peak-report="-1"
			role="group"
		>
			<sonic-meter orientation="horizontal" />
			<div class="flex gap-2 font-mono text-[0.5rem]">
				<sonic-key aria-label="Read peak" data-peak-read>
					<span aria-hidden="true">PEAK</span>
				</sonic-key>
				<sonic-key aria-label="Reset peak" data-peak-reset>
					<span aria-hidden="true">RST</span>
				</sonic-key>
			</div>
			<p class="min-h-4 font-mono text-[0.625rem] text-zinc-300">
				<span role="status" />
				<span class="text-red-300" role="alert" />
			</p>
		</div>
	</Cell>
	<Cell id="meter-run" label="Run">
		<sonic-key aria-labelledby="meter-run" data-run pressed toggle>
			<Play aria-hidden="true" />
		</sonic-key>
	</Cell>
</Panel>
<Panel isLarge={true}>
	<Cell id="meter-large-stereo" label="Stereo, large">
		<div
			aria-labelledby="meter-large-stereo"
			class="flex gap-2 [--sonic-meter-length:16rem] [--sonic-meter-size:1.5rem]"
			role="group"
		>
			<sonic-meter></sonic-meter>
			<sonic-meter></sonic-meter>
		</div>
	</Cell>
	<Cell id="meter-large-ladder" label="Ladder, large">
		<div
			aria-labelledby="meter-large-ladder"
			class="flex gap-2 [--sonic-meter-clip-from:-4] [--sonic-meter-hot-from:-10] [--sonic-meter-length:16rem] [--sonic-meter-size:1.5rem]"
			role="group"
		>
			<sonic-meter lights={ladder}></sonic-meter>
			<sonic-meter lights={ladder}></sonic-meter>
		</div>
	</Cell>
</Panel>
