---
interface Props {
	id: string;
	label: string;
	span?: 'full' | 'wide';
}

const { id, label, span } = Astro.props;
---

<div
	class:list={[
		'row-span-2 grid grid-rows-subgrid justify-items-center gap-y-3',
		{ 'col-span-2': span === 'wide', 'col-span-full': span === 'full' },
	]}
>
	<div class="flex items-center justify-center gap-2">
		<slot />
	</div>
	<span
		class="text-center font-mono text-[0.625rem] tracking-[0.14em] text-balance text-text-muted uppercase"
		id={id}
	>
		{label}
	</span>
</div>
