---
interface Props {
	id: string;
	label: string;
	span?: 'full' | 'wide';
}

const { id, label, span } = Astro.props;
---

<div
	class:list={[
		'grid max-w-full grid-rows-[1fr_auto] justify-items-center gap-y-3',
		span === undefined && 'w-(--specimen-cell)',
		{ 'w-[calc(var(--specimen-cell)*2+1rem)]': span === 'wide', 'w-full': span === 'full' },
	]}
>
	<div class="flex items-center justify-center gap-2">
		<slot />
	</div>
	<span
		class="text-center font-mono text-[0.625rem] tracking-[0.14em] text-balance text-text-muted uppercase"
		id={id}
	>
		{label}
	</span>
</div>
