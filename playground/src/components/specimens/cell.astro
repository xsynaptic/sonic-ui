---
interface Props {
	href?: string;
	id: string;
	isStacked?: boolean;
	label: string;
	span?: 'full' | 'wide';
}

const { href, id, isStacked = false, label, span } = Astro.props;
const captionClass =
	'text-center font-mono text-[0.625rem] tracking-[0.14em] text-balance text-text-muted uppercase';
---

<div
	class:list={[
		'grid max-w-full grid-rows-[1fr_auto] justify-items-center gap-y-3',
		span === undefined && 'w-(--specimen-cell)',
		{ 'w-[calc(var(--specimen-cell)*2+1rem)]': span === 'wide', 'w-full': span === 'full' },
	]}
>
	<div class:list={['flex items-center justify-center', isStacked ? 'flex-col gap-3' : 'gap-2']}>
		<slot />
	</div>
	{href === undefined ? (
		<span class={captionClass} id={id}>
			{label}
		</span>
	) : (
		<a
			class:list={[captionClass, 'text-text-strong underline-offset-4 hover:underline']}
			href={href}
			id={id}
		>
			{label}
		</a>
	)}
</div>
