---
import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const screens = [
	{ id: 'screen-frequency', label: 'Frequency', text: '440 Hz' },
	{ id: 'screen-gain', label: 'Gain', text: '−6.0 dB' },
];
---

<Section title="Text">
	<SpecimenGrid>
		{screens.map((screen) => (
			<Cell id={screen.id} label={screen.label} span="wide">
				<div
					aria-labelledby={screen.id}
					class="sonic-screen min-w-30 font-mono text-sm"
					role="group"
				>
					{screen.text}
				</div>
			</Cell>
		))}
	</SpecimenGrid>
	<SpecimenGrid size="large">
		<Cell id="screen-note" label="Note" span="wide">
			<div
				aria-labelledby="screen-note"
				class="sonic-screen min-w-72 font-mono text-4xl [--sonic-screen-size:6rem]"
				role="group"
			>
				C♯3
			</div>
		</Cell>
	</SpecimenGrid>
</Section>
