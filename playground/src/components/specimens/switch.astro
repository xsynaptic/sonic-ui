---
import Cell from '#components/specimens/cell.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const legend = 'font-mono text-zinc-300 uppercase';
---

<SpecimenGrid>
	<Cell id="switch-sync" label="Sync">
		<sonic-switch aria-labelledby="switch-sync"></sonic-switch>
	</Cell>
	<Cell id="switch-sync-horizontal" label="Sync, horizontal">
		<sonic-switch
			aria-labelledby="switch-sync-horizontal"
			checked
			orientation="horizontal"
		></sonic-switch>
	</Cell>
	<Cell id="switch-loop" label="Loop">
		<sonic-switch aria-labelledby="switch-loop" class={legend} value="pre">
			<span data-sonic-value="pre">Pre</span>
			<span data-sonic-value="post">Post</span>
		</sonic-switch>
	</Cell>
	<Cell id="switch-assign" isWide={true} label="Assign">
		<sonic-switch
			aria-labelledby="switch-assign"
			class={legend}
			orientation="horizontal"
			value="off"
		>
			<span data-sonic-value="1">1</span>
			<span data-sonic-value="off">Off</span>
			<span data-sonic-value="2">2</span>
		</sonic-switch>
	</Cell>
	<Cell id="switch-duck" label="Momentary">
		<sonic-switch aria-labelledby="switch-duck" class={legend} value="off">
			<span data-sonic-momentary data-sonic-value="duck">
				Duck
			</span>
			<span data-sonic-value="off">Off</span>
			<span data-sonic-value="on">On</span>
		</sonic-switch>
	</Cell>
	<Cell id="switch-disabled" label="Disabled">
		<sonic-switch aria-labelledby="switch-disabled" class={legend} disabled value="post">
			<span data-sonic-value="pre">Pre</span>
			<span data-sonic-value="post">Post</span>
		</sonic-switch>
	</Cell>
</SpecimenGrid>
<SpecimenGrid isLarge={true}>
	<Cell id="switch-large-assign" isWide={true} label="Assign, large">
		<sonic-switch
			aria-labelledby="switch-large-assign"
			class:list={[legend, '[--sonic-switch-size:4rem]']}
			orientation="horizontal"
			value="x"
		>
			<span data-sonic-value="x">X</span>
			<span data-sonic-value="off">Off</span>
			<span data-sonic-value="y">Y</span>
		</sonic-switch>
	</Cell>
	<Cell id="switch-large-duck" isWide={true} label="Momentary, large">
		<sonic-switch
			aria-labelledby="switch-large-duck"
			class:list={[legend, '[--sonic-switch-size:4rem]']}
			value="on"
		>
			<span data-sonic-momentary data-sonic-value="duck">
				Duck
			</span>
			<span data-sonic-value="off">Off</span>
			<span data-sonic-value="on">On</span>
		</sonic-switch>
	</Cell>
</SpecimenGrid>
