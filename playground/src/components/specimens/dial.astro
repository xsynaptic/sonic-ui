---
import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';
import { echoModes } from '#scripts/stop-names.ts';

const masterStops = Array.from({ length: 11 }, (_stop, index) => index);
---

<Section title="Values">
	<SpecimenGrid>
		<Cell id="dial-volume" label="Volume">
			<sonic-dial
				aria-labelledby="dial-volume"
				data-format="percent"
				default="70"
				readout
				value="70"
			></sonic-dial>
		</Cell>
		<Cell id="dial-pan" label="Pan">
			<sonic-dial
				aria-labelledby="dial-pan"
				data-format="pan"
				default="0"
				max="50"
				min="-50"
				origin="0"
				readout
				value="-20"
			></sonic-dial>
		</Cell>
		<Cell id="dial-cutoff" label="Cutoff">
			<sonic-dial
				aria-labelledby="dial-cutoff"
				data-format="hertz"
				max="20000"
				min="20"
				readout
				taper="log"
				value="1000"
			></sonic-dial>
		</Cell>
		<Cell id="dial-low" label="Low">
			<sonic-dial
				aria-labelledby="dial-low"
				data-format="db"
				default="0"
				detent="0"
				max="6"
				min="-30"
				origin="0"
				readout
				step="0.5"
				value="-9"
			></sonic-dial>
		</Cell>
		<Cell id="dial-phase" label="Phase">
			<sonic-dial
				aria-labelledby="dial-phase"
				data-format="degrees"
				endless
				max="360"
				readout
				value="90"
			></sonic-dial>
		</Cell>
		<Cell id="dial-depth" label="Depth">
			<sonic-dial
				aria-labelledby="dial-depth"
				data-lfo
				modulation="35"
				readout
				value="40"
			></sonic-dial>
		</Cell>
	</SpecimenGrid>
</Section>
<Section title="Positions">
	<SpecimenGrid>
		<Cell id="dial-filter" label="Filter type">
			<sonic-dial
				aria-labelledby="dial-filter"
				data-format="filter"
				max="3"
				notched
				readout
				value="1"
			></sonic-dial>
		</Cell>
		<Cell id="dial-loop" label="Loop">
			<sonic-dial
				aria-labelledby="dial-loop"
				data-format="beats"
				notched
				positions="0.03125 0.0625 0.125 0.25 0.5 1 2 4 8 16 32"
				readout
				value="4"
			></sonic-dial>
		</Cell>
	</SpecimenGrid>
</Section>
<Section title="Scales">
	<SpecimenGrid>
		<Cell id="dial-master" label="Master" span="wide">
			<sonic-dial
				aria-labelledby="dial-master"
				class="[--sonic-dial-size:4rem] [--sonic-dial-scale-font-ratio:0.16]"
				default="7"
				max="10"
				readout
				step="0.5"
				value="7"
			>
				{masterStops.map((stop) => (
					<span data-sonic-value={stop}>{stop}</span>
				))}
			</sonic-dial>
		</Cell>
		<Cell id="dial-mode" label="Mode" span="wide">
			<sonic-dial
				aria-labelledby="dial-mode"
				class="[--sonic-dial-notch-ratio:0.05] [--sonic-dial-scale-font-ratio:0.085] [--sonic-dial-scale-ratio:0.34] [--sonic-dial-size:6rem] [--sonic-dial-sweep:180deg]"
				data-format="echo-mode"
				max="3"
				notched
				readout
				value="1"
			>
				{echoModes.labels.map((mode, index) => (
					<span data-sonic-value={index}>{mode}</span>
				))}
			</sonic-dial>
		</Cell>
	</SpecimenGrid>
</Section>
<Section title="States">
	<SpecimenGrid>
		<Cell id="dial-bypassed" label="Bypassed">
			<sonic-dial aria-labelledby="dial-bypassed" dimmed value="60"></sonic-dial>
		</Cell>
		<Cell id="dial-disabled" label="Disabled">
			<sonic-dial aria-labelledby="dial-disabled" disabled value="60"></sonic-dial>
		</Cell>
	</SpecimenGrid>
</Section>

<script>
	import '#scripts/specimens/motion.ts';
</script>
