---
import Play from '@lucide/astro/icons/play';

import Cell from '#components/specimens/cell.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';
import { echoModes } from '#scripts/stop-names.ts';

const levelTicks = [-40, -30, -20, -12, -6, 0, 5];
const masterStops = Array.from({ length: 11 }, (_stop, index) => index);
---

<SpecimenGrid>
	<Cell id="dial-volume" label="Volume">
		<sonic-dial
			aria-labelledby="dial-volume"
			data-format="percent"
			default="70"
			readout
			value="70"
		></sonic-dial>
	</Cell>
	<Cell id="dial-pan" label="Pan">
		<sonic-dial
			aria-labelledby="dial-pan"
			data-format="pan"
			default="0"
			max="50"
			min="-50"
			origin="0"
			readout
			value="-20"
		></sonic-dial>
	</Cell>
	<Cell id="dial-filter" label="Filter type">
		<sonic-dial
			aria-labelledby="dial-filter"
			data-format="filter"
			max="3"
			notched
			readout
			value="1"
		></sonic-dial>
	</Cell>
	<Cell id="dial-cutoff" label="Cutoff">
		<sonic-dial
			aria-labelledby="dial-cutoff"
			data-format="hertz"
			max="20000"
			min="20"
			readout
			taper="log"
			value="1000"
		></sonic-dial>
	</Cell>
	<Cell id="dial-attack" label="Attack">
		<sonic-dial
			aria-labelledby="dial-attack"
			data-format="milliseconds"
			max="2000"
			midpoint="200"
			readout
			value="200"
		></sonic-dial>
	</Cell>
	<Cell id="dial-phase" label="Phase">
		<sonic-dial
			aria-labelledby="dial-phase"
			data-format="degrees"
			endless
			max="360"
			readout
			value="90"
		></sonic-dial>
	</Cell>
	<Cell id="dial-angle" label="Angle">
		<sonic-dial
			aria-labelledby="dial-angle"
			data-format="degrees"
			endless
			max="360"
			notched
			readout
			step="45"
			value="135"
		></sonic-dial>
	</Cell>
	<Cell id="dial-low" label="Low">
		<sonic-dial
			aria-labelledby="dial-low"
			data-format="db"
			default="0"
			detent="0"
			max="6"
			min="-30"
			origin="0"
			readout
			step="0.5"
			value="-9"
		></sonic-dial>
	</Cell>
	<Cell id="dial-loop" label="Loop">
		<sonic-dial
			aria-labelledby="dial-loop"
			data-format="beats"
			notched
			positions="0.03125 0.0625 0.125 0.25 0.5 1 2 4 8 16 32"
			readout
			value="4"
		></sonic-dial>
	</Cell>
	<Cell id="dial-level" label="Level">
		<sonic-dial
			aria-labelledby="dial-level"
			class="[--sonic-dial-size:3.5rem]"
			data-format="db-kill"
			default="0"
			detent="0"
			max="10"
			midpoint="-12"
			min="-60"
			readout
			step="0.5"
			value="0"
		>
			<span data-sonic-value="-60">∞</span>
			{levelTicks.map((tick) => (
				<span data-sonic-value={tick}></span>
			))}
			<span data-sonic-value="10">+10</span>
		</sonic-dial>
	</Cell>
	<Cell id="dial-master" label="Master">
		<sonic-dial
			aria-labelledby="dial-master"
			class="[--sonic-dial-size:4rem] [--sonic-dial-scale-font-ratio:0.16]"
			default="7"
			max="10"
			readout
			step="0.5"
			value="7"
		>
			{masterStops.map((stop) => (
				<span data-sonic-value={stop}>{stop}</span>
			))}
		</sonic-dial>
	</Cell>
	<Cell id="dial-mode" label="Mode">
		<sonic-dial
			aria-labelledby="dial-mode"
			class="[--sonic-dial-notch-ratio:0.05] [--sonic-dial-scale-font-ratio:0.085] [--sonic-dial-scale-ratio:0.34] [--sonic-dial-size:6rem] [--sonic-dial-sweep:180deg]"
			data-format="echo-mode"
			max="3"
			notched
			readout
			value="1"
		>
			{echoModes.labels.map((mode, index) => (
				<span data-sonic-value={index}>{mode}</span>
			))}
		</sonic-dial>
	</Cell>
	<Cell id="dial-high-sensitivity" label="High sensitivity">
		<sonic-dial
			aria-labelledby="dial-high-sensitivity"
			class="[--sonic-dial-travel:48px]"
			data-format="percent"
			readout
			value="50"
		></sonic-dial>
	</Cell>
	<Cell id="dial-low-sensitivity" label="Low sensitivity">
		<sonic-dial
			aria-labelledby="dial-low-sensitivity"
			class="[--sonic-dial-travel:640px]"
			data-format="percent"
			readout
			value="50"
		></sonic-dial>
	</Cell>
	<Cell id="dial-wobble" label="Wobble">
		<sonic-dial aria-labelledby="dial-wobble" data-lfo="25" readout value="50"></sonic-dial>
	</Cell>
	<Cell id="dial-depth" label="Depth">
		<sonic-dial
			aria-labelledby="dial-depth"
			data-lfo
			modulation="35"
			readout
			value="40"
		></sonic-dial>
	</Cell>
	<Cell id="dial-run" label="Run">
		<sonic-button aria-labelledby="dial-run" data-run latching pressed>
			<Play aria-hidden="true" />
		</sonic-button>
	</Cell>
	<Cell id="dial-bypassed" label="Bypassed">
		<sonic-dial aria-labelledby="dial-bypassed" dimmed value="60"></sonic-dial>
	</Cell>
	<Cell id="dial-disabled" label="Disabled">
		<sonic-dial aria-labelledby="dial-disabled" disabled value="60"></sonic-dial>
	</Cell>
</SpecimenGrid>
<SpecimenGrid isLarge={true}>
	<Cell id="dial-large-volume" label="Volume, large">
		<sonic-dial
			aria-labelledby="dial-large-volume"
			class="[--sonic-dial-size:8rem]"
			data-format="percent"
			default="70"
			readout
			value="70"
		></sonic-dial>
	</Cell>
	<Cell id="dial-large-pan" label="Pan, large">
		<sonic-dial
			aria-labelledby="dial-large-pan"
			class="[--sonic-dial-size:8rem]"
			data-format="pan"
			default="0"
			max="50"
			min="-50"
			origin="0"
			readout
			value="-20"
		></sonic-dial>
	</Cell>
	<Cell id="dial-large-filter" label="Filter type, large">
		<sonic-dial
			aria-labelledby="dial-large-filter"
			class="[--sonic-dial-size:8rem]"
			data-format="filter"
			max="3"
			notched
			readout
			value="1"
		></sonic-dial>
	</Cell>
	<Cell id="dial-large-phase" label="Phase, large">
		<sonic-dial
			aria-labelledby="dial-large-phase"
			class="[--sonic-dial-size:8rem]"
			data-format="degrees"
			endless
			max="360"
			readout
			value="90"
		></sonic-dial>
	</Cell>
	<Cell id="dial-large-bypassed" label="Bypassed, large">
		<sonic-dial
			aria-labelledby="dial-large-bypassed"
			class="[--sonic-dial-size:8rem]"
			dimmed
			value="60"
		></sonic-dial>
	</Cell>
</SpecimenGrid>
