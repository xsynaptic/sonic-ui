---
import Lock from '@lucide/astro/icons/lock';

import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const sliders = [
	{ id: 'split-a', label: 'A', value: 50 },
	{ id: 'split-b', label: 'B', value: 30 },
	{ id: 'split-c', label: 'C', value: 20 },
];
const modes = [
	['proportional', 'Share'],
	['equal', 'Equal'],
	['cascade', 'Next'],
] as const;
---

<Section title="Shares">
	<SpecimenGrid>
		<div class="contents" data-split-demo>
			<Cell id="split-mode" label="Mode" span="full">
				<sonic-segmented
					aria-labelledby="split-mode"
					class="font-mono"
					data-split-mode
					value="proportional"
				>
					{modes.map(([value, label]) => (
						<span data-sonic-value={value}>{label}</span>
					))}
				</sonic-segmented>
			</Cell>
			<sonic-split aria-label="Three-way split" class="contents">
				{sliders.map((slider) => (
					<Cell id={slider.id} isStacked={true} label={slider.label}>
						<sonic-slider
							aria-labelledby={slider.id}
							class="[--sonic-slider-length:9rem]"
							orientation="vertical"
							value={slider.value}
						></sonic-slider>
						<span
							aria-hidden="true"
							class="sonic-screen min-w-10 font-mono text-xs tabular-nums [--sonic-screen-size:1.25rem]"
							data-split-readout
						>
							{slider.value}
						</span>
						<sonic-button aria-label={`Lock ${slider.label}`} data-split-lock latching>
							<Lock aria-hidden="true" />
						</sonic-button>
					</Cell>
				))}
			</sonic-split>
		</div>
	</SpecimenGrid>
</Section>
<Section title="Members">
	<SpecimenGrid>
		<sonic-split aria-label="Mixed members" class="contents" total="150">
			<Cell id="split-dial" label="Low">
				<sonic-dial aria-labelledby="split-dial" readout value="60"></sonic-dial>
			</Cell>
			<Cell id="split-slider" label="Mid" span="wide">
				<sonic-slider aria-labelledby="split-slider" readout value="50"></sonic-slider>
			</Cell>
			<Cell id="split-number" label="High">
				<div class="sonic-screen w-fit [font-family:var(--sonic-glass-font,var(--font-mono))] [--sonic-screen-inset-ratio:0] [--sonic-screen-size:1.75rem]">
					<sonic-number aria-labelledby="split-number" value="40"></sonic-number>
				</div>
			</Cell>
		</sonic-split>
	</SpecimenGrid>
</Section>

<script>
	import '#scripts/specimens/split.ts';
</script>
