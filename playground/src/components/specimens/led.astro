---
import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const lamps = [
	{ id: 'led-off', label: 'Off' },
	{ id: 'led-on', label: 'Lit', lit: '' },
	{ id: 'led-idle', label: 'Idle', lit: 'idle' },
	{ id: 'led-ok', label: 'Ok', lit: 'ok' },
	{ id: 'led-warning', label: 'Warning', lit: 'warning' },
	{ id: 'led-danger', label: 'Danger', lit: 'danger' },
];
---

<Section title="Lit colours">
	<SpecimenGrid>
		{lamps.map((lamp) => (
			<Cell id={lamp.id} label={lamp.label}>
				<span class="sonic-led" data-sonic-lit={lamp.lit}></span>
			</Cell>
		))}
	</SpecimenGrid>
</Section>
<Section title="On buttons">
	<SpecimenGrid>
		<Cell id="led-input" label="Phono or line">
			<sonic-button
				aria-labelledby="led-input"
				class="font-mono [--sonic-button-font-ratio:0.25]"
				data-two-colour
				latching
			>
				<span class="sonic-led" data-sonic-lit="ok"></span>
				<span aria-hidden="true">PH</span>
			</sonic-button>
		</Cell>
		<Cell id="led-power" label="Power">
			<sonic-button aria-labelledby="led-power" latching pressed>
				<span class="sonic-led"></span>
			</sonic-button>
		</Cell>
		<Cell id="led-sync" label="Sync">
			<sonic-button aria-labelledby="led-sync" class="font-mono text-[0.5rem]" latching>
				<span class="sonic-led"></span>
				<span aria-hidden="true">SYNC</span>
			</sonic-button>
		</Cell>
	</SpecimenGrid>
</Section>

<script>
	import '#scripts/two-colour.ts';
</script>
