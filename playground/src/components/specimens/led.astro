---
import Power from '@lucide/astro/icons/power';
import Repeat from '@lucide/astro/icons/repeat';

import Cell from '#components/specimens/cell.astro';
import Panel from '#components/specimens/panel.astro';
---

<Panel>
	<Cell id="led-off" label="Off">
		<span class="sonic-led"></span>
	</Cell>
	<Cell id="led-on" label="On">
		<span class="sonic-led" data-sonic-lit></span>
	</Cell>
	<Cell id="led-green" label="Green">
		<span class="sonic-led [--sonic-lit:#22c55e]" data-sonic-lit></span>
	</Cell>
	<Cell id="led-alt" label="Alt">
		<span class="sonic-led" data-sonic-lit="alt"></span>
	</Cell>
	<Cell id="led-dim" label="Dim">
		<span class="sonic-led" data-sonic-lit="dim"></span>
	</Cell>
	<Cell id="led-hot" label="Hot">
		<span class="sonic-led" data-sonic-lit="hot"></span>
	</Cell>
	<Cell id="led-clip" label="Clip">
		<span class="sonic-led" data-sonic-lit="clip"></span>
	</Cell>
	<Cell id="led-status" label="Status">
		<span class="sonic-led" data-sonic-lit></span>
		<span class="sonic-led" data-sonic-lit="hot"></span>
		<span class="sonic-led" data-sonic-lit="clip"></span>
	</Cell>
	<Cell id="led-input" label="Phono or line">
		<sonic-key aria-labelledby="led-input" class="font-mono text-[0.5rem]" data-two-colour toggle>
			<span class="sonic-led" data-sonic-lit="alt"></span>
			<span aria-hidden="true">PH</span>
		</sonic-key>
	</Cell>
	<Cell id="led-power" label="Power">
		<sonic-key aria-labelledby="led-power" pressed toggle>
			<span class="sonic-led"></span>
		</sonic-key>
	</Cell>
	<Cell id="led-loop" label="Loop">
		<sonic-key aria-labelledby="led-loop" toggle>
			<span class="sonic-led"></span>
			<Repeat aria-hidden="true" />
		</sonic-key>
	</Cell>
	<Cell id="led-sync" label="Sync">
		<sonic-key aria-labelledby="led-sync" class="font-mono text-[0.5rem]" toggle>
			<span class="sonic-led"></span>
			<span aria-hidden="true">SYNC</span>
		</sonic-key>
	</Cell>
</Panel>
<Panel isLarge={true}>
	<Cell id="led-large-power" label="Power, large">
		<sonic-key aria-labelledby="led-large-power" class="[--sonic-key-size:6rem]" pressed toggle>
			<span class="sonic-led"></span>
			<Power aria-hidden="true" />
		</sonic-key>
	</Cell>
	<Cell id="led-large-alt" label="Alt, large">
		<span class="sonic-led [--sonic-led-size:2rem]" data-sonic-lit="alt"></span>
	</Cell>
	<Cell id="led-large-on" label="On, large">
		<span class="sonic-led [--sonic-led-size:2rem]" data-sonic-lit></span>
	</Cell>
</Panel>
