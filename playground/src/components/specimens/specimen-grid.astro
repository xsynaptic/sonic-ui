---
interface Props {
	size?: 'large' | 'small' | 'wide';
}

const { size = 'small' } = Astro.props;

// A cell keeps a fixed width, so a short last row centres instead of packing left
// Outside a grid the width is unset and a cell takes its content's
const cell = {
	large: '[--specimen-cell:12rem]',
	small: '[--specimen-cell:8rem]',
	wide: '[--specimen-cell:22rem]',
};
---

<div class="surface p-5 text-text-muted not-first:mt-3">
	<div class:list={['flex flex-wrap justify-center gap-x-4 gap-y-6', cell[size]]}>
		<slot />
	</div>
</div>
