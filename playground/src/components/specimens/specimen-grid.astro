---
interface Props {
	size?: 'large' | 'small' | 'wide';
}

const { size = 'small' } = Astro.props;

const columns = {
	large: 'grid-cols-[repeat(auto-fit,minmax(min(12rem,100%),1fr))]',
	small: 'grid-cols-[repeat(auto-fit,minmax(min(8rem,100%),1fr))]',
	wide: 'grid-cols-[repeat(auto-fit,minmax(min(22rem,100%),1fr))]',
};
---

<div class="surface p-5 text-text-muted not-first:mt-3">
	<div class:list={['grid gap-x-4 gap-y-6', columns[size]]}>
		<slot />
	</div>
</div>
