---
import Cell from '#components/specimens/cell.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const markers = '30 60..95:intro 140 150 215 260~';

const strips = [
	{ id: 'wavestrip-default', label: 'Default', seed: 1 },
	{ id: 'wavestrip-dimmed', isDimmed: true, label: 'Dimmed', seed: 3 },
	{ id: 'wavestrip-disabled', isDisabled: true, label: 'Disabled', seed: 4 },
	{ id: 'wavestrip-empty', label: 'Empty' },
	{ className: '[--sonic-glass-depth:0]', id: 'wavestrip-flat', label: 'Flat', seed: 5 },
	{
		id: 'wavestrip-stacked',
		label: 'Stacked markers',
		markers: '30 32 34 36 60..95:intro 140 142 215 216 217 260~',
		seed: 6,
	},
	{ format: 'seconds', id: 'wavestrip-seconds', label: 'Readout in seconds', seed: 7 },
];
---

<SpecimenGrid isLarge={true}>
	{strips.map((strip) => (
		<Cell id={strip.id} isWide={true} label={strip.label}>
			<sonic-wavestrip
				aria-labelledby={strip.id}
				cancellable
				class:list={['[--sonic-wavestrip-length:20rem]', strip.className]}
				data-buffered="0 150 190 230"
				data-format={strip.format ?? 'clock'}
				data-markers={strip.markers ?? markers}
				data-peaks={strip.seed}
				dimmed={strip.isDimmed}
				disabled={strip.isDisabled}
				key-step="5"
				max="300"
				readout
				value="120"
			></sonic-wavestrip>
		</Cell>
	))}
</SpecimenGrid>
<SpecimenGrid isLarge={true}>
	<div class="col-span-full">
		<Cell id="wavestrip-large" label="Large">
			<sonic-wavestrip
				aria-labelledby="wavestrip-large"
				cancellable
				class="[--sonic-wavestrip-length:min(48rem,80vw)] [--sonic-wavestrip-marker-ratio:0.14] [--sonic-wavestrip-size:5rem]"
				data-buffered="0 150 190 230"
				data-format="clock"
				data-markers={markers}
				data-peaks="8"
				key-step="5"
				max="300"
				readout
				value="120"
			></sonic-wavestrip>
		</Cell>
	</div>
</SpecimenGrid>
