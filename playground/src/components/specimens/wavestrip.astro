---
import Cell from '#components/specimens/cell.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const markers = '30 60..95:intro 140 150 215 260~';

const strips = [
	{ id: 'wavestrip-default', label: 'Default', seed: 1 },
	{ id: 'wavestrip-dimmed', isDimmed: true, label: 'Dimmed', seed: 3 },
	{ id: 'wavestrip-disabled', isDisabled: true, label: 'Disabled', seed: 4 },
	{ id: 'wavestrip-empty', label: 'Empty' },
	{
		id: 'wavestrip-stacked',
		label: 'Stacked markers',
		markers: '30 32 34 36 60..95:intro 140 142 215 216 217 260~',
		seed: 6,
	},
	{ format: 'seconds', id: 'wavestrip-seconds', label: 'Readout in seconds', seed: 7 },
	{ hasGlass: true, id: 'wavestrip-glass', label: 'On glass', seed: 10 },
	{
		hasGlass: true,
		id: 'wavestrip-glass-dimmed',
		isDimmed: true,
		label: 'On glass, dimmed',
		seed: 11,
	},
	{
		hasGlass: true,
		id: 'wavestrip-glass-flat',
		label: 'On flat glass',
		screenClass: '[--sonic-glass-depth:0]',
		seed: 5,
	},
];
---

<SpecimenGrid isLarge={true}>
	{strips.map((strip) => (
		<Cell id={strip.id} isWide={true} label={strip.label}>
			<div class:list={[strip.hasGlass && 'sonic-screen', strip.screenClass]}>
				<sonic-wavestrip
					aria-labelledby={strip.id}
					cancellable
					class="[--sonic-wavestrip-length:20rem]"
					data-buffered="0 150 190 230"
					data-format={strip.format ?? 'clock'}
					data-markers={strip.markers ?? markers}
					data-peaks={strip.seed}
					dimmed={strip.isDimmed}
					disabled={strip.isDisabled}
					key-step="5"
					max="300"
					readout
					value="120"
				></sonic-wavestrip>
			</div>
		</Cell>
	))}
</SpecimenGrid>
<SpecimenGrid isLarge={true}>
	<Cell id="wavestrip-fill" isWide={true} label="Fills its row">
		<div class="flex h-24 w-80">
			<sonic-wavestrip
				aria-labelledby="wavestrip-fill"
				class="[--sonic-touch-action:none] [--sonic-wavestrip-length:100%]"
				data-format="clock"
				data-markers={markers}
				data-peaks="9"
				fill
				key-step="5"
				max="300"
				readout
				spoken-step="1"
				step="0"
				value="120"
			></sonic-wavestrip>
		</div>
	</Cell>
	<Cell id="wavestrip-glass-fill" isWide={true} label="On glass, fills its row">
		<div class="sonic-screen h-24 w-80 [--sonic-wavestrip-length:100%]">
			<sonic-wavestrip
				aria-labelledby="wavestrip-glass-fill"
				data-format="clock"
				data-markers={markers}
				data-peaks="13"
				fill
				key-step="5"
				max="300"
				readout
				value="120"
			></sonic-wavestrip>
		</div>
	</Cell>
	<div class="col-span-full">
		<Cell id="wavestrip-large" label="Large">
			<sonic-wavestrip
				aria-labelledby="wavestrip-large"
				cancellable
				class="[--sonic-wavestrip-length:min(48rem,80vw)] [--sonic-wavestrip-marker-ratio:0.14] [--sonic-wavestrip-size:5rem]"
				data-buffered="0 150 190 230"
				data-format="clock"
				data-markers={markers}
				data-peaks="8"
				key-step="5"
				max="300"
				readout
				value="120"
			></sonic-wavestrip>
		</Cell>
	</div>
	<div class="col-span-full">
		<Cell id="wavestrip-large-glass" label="Large, on glass">
			<div class="sonic-screen [--sonic-screen-size:5rem]">
				<sonic-wavestrip
					aria-labelledby="wavestrip-large-glass"
					cancellable
					class="[--sonic-wavestrip-length:min(48rem,80vw)] [--sonic-wavestrip-marker-ratio:0.14] [--sonic-wavestrip-size:5rem]"
					data-buffered="0 150 190 230"
					data-format="clock"
					data-markers={markers}
					data-peaks="12"
					key-step="5"
					max="300"
					readout
					value="120"
				></sonic-wavestrip>
			</div>
		</Cell>
	</div>
</SpecimenGrid>
