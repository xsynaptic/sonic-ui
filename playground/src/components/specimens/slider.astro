---
import Cell from '#components/specimens/cell.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const faderMarks = [
	[10, '+10'],
	[5, ''],
	[0, '0'],
	[-5, ''],
	[-10, '−10'],
	[-20, '−20'],
	[-30, '−30'],
	[-40, ''],
	[-60, '∞'],
] as const;
---

<SpecimenGrid>
	<Cell id="slider-send" isWide={true} label="Send">
		<sonic-slider
			aria-labelledby="slider-send"
			data-format="percent"
			readout
			value="40"
		></sonic-slider>
	</Cell>
	<Cell id="slider-crossfader" isWide={true} label="Crossfader">
		<sonic-slider
			aria-labelledby="slider-crossfader"
			default="0"
			double-press="reset"
			groove-press="none"
			max="50"
			min="-50"
			origin="0"
			value="-30"
		></sonic-slider>
	</Cell>
	<Cell id="slider-blend" isWide={true} label="Blend">
		<sonic-slider
			aria-labelledby="slider-blend"
			class="[--sonic-slider-size:3.25rem]"
			data-format="signed-percent"
			default="0"
			max="50"
			min="-50"
			origin="0"
			readout
			value="-20"
		>
			<span data-sonic-value="-50">A</span>
			<span data-sonic-value="-25"></span>
			<span data-sonic-value="0"></span>
			<span data-sonic-value="25"></span>
			<span data-sonic-value="50">B</span>
		</sonic-slider>
	</Cell>
	<Cell id="slider-modulated" isWide={true} label="Modulated">
		<sonic-slider
			aria-labelledby="slider-modulated"
			data-format="percent"
			data-lfo="25"
			readout
			value="50"
		></sonic-slider>
	</Cell>
	<Cell id="slider-depth" isWide={true} label="Depth">
		<sonic-slider
			aria-labelledby="slider-depth"
			data-format="percent"
			data-lfo
			modulation="35"
			readout
			value="40"
		></sonic-slider>
	</Cell>
	<Cell id="slider-seek" isWide={true} label="Seek">
		<sonic-slider
			aria-labelledby="slider-seek"
			class="[--sonic-slider-cap-ratio:0] [--sonic-slider-groove-hover-ratio:0.5] [--sonic-slider-groove-ratio:0.25] [--sonic-slider-size:1rem]"
			data-buffered="0 150 190 230"
			data-format="clock"
			key-step="5"
			max="300"
			readout
			scrub
			step="0"
			value="120"
		></sonic-slider>
	</Cell>
	<Cell id="slider-strip" isWide={true} label="Strip">
		<sonic-slider
			aria-labelledby="slider-strip"
			class="[--sonic-slider-cap-ratio:0] [--sonic-slider-groove-anchor:1] [--sonic-slider-groove-hover-ratio:0.5] [--sonic-slider-groove-radius-ratio:0] [--sonic-slider-groove-ratio:0.25] [--sonic-slider-size:1rem]"
			data-buffered="0 150 190 230"
			data-format="clock"
			key-step="5"
			max="300"
			readout
			scrub
			step="0"
			value="120"
		></sonic-slider>
	</Cell>
	<Cell id="slider-fader" label="Fader">
		<sonic-slider
			aria-labelledby="slider-fader"
			data-format="db"
			default="0"
			max="6"
			midpoint="-12"
			min="-60"
			orientation="vertical"
			readout
			step="0.5"
			value="0"
		></sonic-slider>
	</Cell>
	<Cell id="slider-scale" label="Scale">
		<sonic-slider
			aria-labelledby="slider-scale"
			class="[--sonic-slider-length:10rem] [--sonic-slider-size:3.25rem]"
			data-format="db-kill"
			default="0"
			max="10"
			midpoint="-12"
			min="-60"
			orientation="vertical"
			readout
			step="0.5"
			value="0"
		>
			{faderMarks.map(([value, text]) => (
				<span data-sonic-value={value}>{text}</span>
			))}
		</sonic-slider>
	</Cell>
	<Cell id="slider-steps" label="Steps">
		<sonic-slider
			aria-labelledby="slider-steps"
			max="10"
			notched
			orientation="vertical"
			readout
			value="7"
		></sonic-slider>
	</Cell>
	<Cell id="slider-progress" isWide={true} label="Progress">
		<sonic-slider
			aria-labelledby="slider-progress"
			data-buffered="0 38 52 71"
			data-format="percent"
			readout
			value="24"
		></sonic-slider>
	</Cell>
	<Cell id="slider-bend" label="Bend">
		<sonic-slider
			aria-labelledby="slider-bend"
			data-format="signed-percent"
			max="100"
			min="-100"
			orientation="vertical"
			origin="0"
			readout
			spring
			value="0"
		></sonic-slider>
	</Cell>
	<Cell id="slider-pitch" label="Pitch">
		<sonic-slider
			aria-labelledby="slider-pitch"
			data-format="signed-percent"
			default="0"
			detent="0"
			max="8"
			min="-8"
			orientation="vertical"
			origin="0"
			readout
			step="0.05"
			value="1.5"
		>
			<span class="sonic-led"></span>
		</sonic-slider>
	</Cell>
	<Cell id="slider-disabled" label="Disabled">
		<sonic-slider
			aria-labelledby="slider-disabled"
			disabled
			orientation="vertical"
			value="60"
		></sonic-slider>
	</Cell>
</SpecimenGrid>
<SpecimenGrid isLarge={true}>
	<Cell id="slider-large-send" isWide={true} label="Send, large">
		<sonic-slider
			aria-labelledby="slider-large-send"
			class="[--sonic-slider-length:20rem] [--sonic-slider-size:4rem]"
			data-format="percent"
			readout
			value="40"
		></sonic-slider>
	</Cell>
	<Cell id="slider-large-modulated" label="Modulated, large">
		<sonic-slider
			aria-labelledby="slider-large-modulated"
			class="[--sonic-slider-length:16rem] [--sonic-slider-size:4rem]"
			data-format="percent"
			data-lfo="25"
			orientation="vertical"
			readout
			value="50"
		></sonic-slider>
	</Cell>
	<Cell id="slider-large-fader" label="Fader, large">
		<sonic-slider
			aria-labelledby="slider-large-fader"
			class="[--sonic-slider-length:16rem] [--sonic-slider-size:4rem]"
			data-format="db"
			default="0"
			max="6"
			midpoint="-12"
			min="-60"
			orientation="vertical"
			readout
			step="0.5"
			value="0"
		></sonic-slider>
	</Cell>
	<Cell id="slider-large-steps" label="Steps, large">
		<sonic-slider
			aria-labelledby="slider-large-steps"
			class="[--sonic-slider-length:16rem] [--sonic-slider-size:4rem]"
			max="10"
			notched
			orientation="vertical"
			readout
			value="7"
		></sonic-slider>
	</Cell>
</SpecimenGrid>
