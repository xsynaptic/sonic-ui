---
import Volume2 from '@lucide/astro/icons/volume-2';
import VolumeX from '@lucide/astro/icons/volume-x';

import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const legend = 'font-mono uppercase';
---

<Section title="Positions">
	<SpecimenGrid>
		<Cell id="toggle-sync" label="Sync">
			<sonic-toggle aria-labelledby="toggle-sync"></sonic-toggle>
		</Cell>
		<Cell id="toggle-mix" label="Mix">
			<sonic-toggle aria-labelledby="toggle-mix" class={legend} value="dry">
				<span data-sonic-value="dry">Dry</span>
				<span data-sonic-value="wet">Wet</span>
			</sonic-toggle>
		</Cell>
		<Cell id="toggle-assign" label="Assign">
			<sonic-toggle aria-labelledby="toggle-assign" class={legend} value="off">
				<span data-sonic-value="1">1</span>
				<span data-sonic-value="off">Off</span>
				<span data-sonic-value="2">2</span>
			</sonic-toggle>
		</Cell>
		<Cell id="toggle-vertical" label="Pickup">
			<sonic-toggle
				aria-labelledby="toggle-vertical"
				class={legend}
				orientation="vertical"
				value="off"
			>
				<span data-sonic-value="1">1</span>
				<span data-sonic-value="off">Off</span>
				<span data-sonic-value="2">2</span>
			</sonic-toggle>
		</Cell>
		<Cell id="toggle-cue" label="Cue">
			<sonic-toggle aria-labelledby="toggle-cue" class={legend} value="off">
				<span data-sonic-lit data-sonic-momentary data-sonic-value="cue">
					Cue
				</span>
				<span data-sonic-value="off">Off</span>
				<span data-sonic-value="on">On</span>
			</sonic-toggle>
		</Cell>
	</SpecimenGrid>
</Section>
<Section title="Legends">
	<SpecimenGrid>
		<Cell id="toggle-monitor" label="Monitor">
			<sonic-toggle aria-labelledby="toggle-monitor" value="on">
				<VolumeX aria-label="Muted" data-sonic-value="muted" role="img" />
				<Volume2 aria-label="On" data-sonic-lit data-sonic-value="on" role="img" />
			</sonic-toggle>
		</Cell>
		<Cell id="toggle-outside-loop" label="Loop">
			<sonic-toggle
				aria-labelledby="toggle-outside-loop"
				class={legend}
				legends="outside"
				value="pre"
			>
				<span data-sonic-value="pre">Pre</span>
				<span data-sonic-value="post">Post</span>
			</sonic-toggle>
		</Cell>
	</SpecimenGrid>
</Section>
<Section title="Lights">
	<SpecimenGrid>
		<Cell id="toggle-bypass" label="Bypass">
			<sonic-toggle aria-labelledby="toggle-bypass" class={legend} value="a">
				<span data-sonic-lit data-sonic-value="a">
					A
				</span>
				<span data-sonic-value="off">Off</span>
				<span data-sonic-lit="ok" data-sonic-value="b">
					B
				</span>
			</sonic-toggle>
		</Cell>
		<Cell id="toggle-power" label="Power">
			<sonic-toggle aria-labelledby="toggle-power" checked>
				<span class="sonic-led"></span>
			</sonic-toggle>
		</Cell>
	</SpecimenGrid>
</Section>
<Section title="States">
	<SpecimenGrid>
		<Cell id="toggle-position-disabled" label="One position disabled" span="wide">
			<sonic-toggle aria-labelledby="toggle-position-disabled" class={legend} value="off">
				<span data-sonic-value="1">1</span>
				<span data-sonic-value="off">Off</span>
				<span data-sonic-disabled data-sonic-value="2">
					2
				</span>
			</sonic-toggle>
		</Cell>
		<Cell id="toggle-disabled" label="Disabled">
			<sonic-toggle aria-labelledby="toggle-disabled" class={legend} disabled value="wet">
				<span data-sonic-value="dry">Dry</span>
				<span data-sonic-value="wet">Wet</span>
			</sonic-toggle>
		</Cell>
	</SpecimenGrid>
</Section>
