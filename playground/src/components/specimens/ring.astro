---
import Repeat from '@lucide/astro/icons/repeat';

import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';
---

<Section title="Rings">
	<SpecimenGrid>
		<Cell id="ring-loop" label="Loop">
			<span class="sonic-ring [--sonic-ring-size:calc(2rem/0.75)]" data-ring-loop>
				<sonic-button aria-labelledby="ring-loop" latching pressed>
					<Repeat aria-hidden="true" />
				</sonic-button>
			</span>
		</Cell>
		<Cell id="ring-progress" label="Progress">
			<span
				aria-labelledby="ring-progress"
				aria-valuenow="65"
				class="sonic-ring"
				role="progressbar"
				style={{ '--sonic-ring-to': '0.65' }}
			></span>
		</Cell>
		<Cell id="ring-dial" label="Send">
			<span
				class="sonic-ring [--sonic-lit:#22c55e] [--sonic-ring-size:calc(2.5rem/0.75)] [--sonic-ring-start:210deg] [--sonic-ring-sweep:300deg]"
				style={{ '--sonic-ring-to': '0.45' }}
			>
				<sonic-dial
					aria-labelledby="ring-dial"
					class="[--sonic-lit:initial]"
					value="70"
				></sonic-dial>
			</span>
		</Cell>
		<Cell id="ring-from-to" label="Range">
			<span
				class="sonic-ring [--sonic-ring-size:calc(2rem/0.75)]"
				style={{ '--sonic-ring-from': '0.25', '--sonic-ring-to': '0.6' }}
			>
				<sonic-button aria-labelledby="ring-from-to" latching>
					<span class="sonic-led"></span>
				</sonic-button>
			</span>
		</Cell>
	</SpecimenGrid>
</Section>

<script>
	import '#scripts/specimens/motion.ts';
</script>
