---
import { filterTypes } from '#scripts/stop-names.ts';

interface Props {
	hasNotch: boolean;
}

const { hasNotch } = Astro.props;

const labels = hasNotch ? filterTypes.labels : filterTypes.labels.slice(0, -1);
---

{labels.map((label, index) => (
	<span data-sonic-value={filterTypes.valueAt(index)}>{label}</span>
))}
