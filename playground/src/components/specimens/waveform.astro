---
import ZoomIn from '@lucide/astro/icons/zoom-in';
import ZoomOut from '@lucide/astro/icons/zoom-out';

import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

interface Wave {
	bands?: number;
	className?: string;
	hasGlass?: boolean;
	id: string;
	isDimmed?: boolean;
	isDisabled?: boolean;
	isInert?: boolean;
	isPlaying?: boolean;
	label: string;
	markers?: string;
	pending?: string;
	seed: number;
	sizeClass?: string;
	style?: string;
	zoom?: number;
}

function ramp(bandCount: number): string {
	return Array.from({ length: bandCount }, (_band, band) => {
		const hue = 25 + (band * 250) / (bandCount - 1);

		return `--sonic-waveform-band-${String(band + 1)}: oklch(0.75 0.19 ${String(hue)})`;
	}).join('; ');
}

const tonal = [
	'--sonic-waveform-band-1: oklch(0.36 0.03 255)',
	'--sonic-waveform-band-2: oklch(0.64 0.015 255)',
	'--sonic-waveform-band-3: oklch(0.96 0 0)',
	'--sonic-waveform-band-normalize: 0',
	'--sonic-waveform-band-contrast: 2',
	'--sonic-waveform-band-tilt: 6',
].join('; ');

const groups: Array<{ hasZoom?: boolean; title: string; waves: Array<Wave> }> = [
	{
		hasZoom: true,
		title: 'Playback',
		waves: [
			{ id: 'waveform-playing', isPlaying: true, label: 'Track', seed: 7 },
			{
				className: '[--sonic-waveform-label-fade-start:0.5]',
				id: 'waveform-mix',
				isPlaying: true,
				label: 'Mix',
				markers:
					'146=First_artist|Opening 151.5=Second_artist|Second_track 158=Third_artist|Outro~',
				seed: 18,
			},
		],
	},
	{
		title: 'Bands',
		waves: [
			{ bands: 3, id: 'waveform-bands', isPlaying: true, label: 'Low, mid, high', seed: 22 },
			{
				bands: 3,
				hasGlass: true,
				id: 'waveform-bands-tonal',
				isPlaying: true,
				label: 'Tonal',
				seed: 28,
				style: tonal,
			},
		],
	},
	{
		title: 'Glass',
		waves: [
			{ hasGlass: true, id: 'waveform-glass', isPlaying: true, label: 'Deck', seed: 19 },
			{
				hasGlass: true,
				id: 'waveform-inert',
				isInert: true,
				isPlaying: true,
				label: 'Thumbnail',
				markers: '',
				seed: 21,
				sizeClass: '[--sonic-waveform-length:6rem] [--sonic-waveform-size:2rem]',
				zoom: 96,
			},
		],
	},
	{
		title: 'States',
		waves: [
			{ id: 'waveform-pending', label: 'Pending', pending: '151 162', seed: 9 },
			{ bands: 3, id: 'waveform-dimmed', isDimmed: true, label: 'Dimmed', seed: 24 },
			{ bands: 3, id: 'waveform-disabled', isDisabled: true, label: 'Disabled', seed: 25 },
		],
	},
];
---

{groups.map((group) => (
	<Section title={group.title}>
		<SpecimenGrid size="wide">
			{group.waves.map((wave) => (
				<Cell id={wave.id} label={wave.label}>
					<div class:list={[wave.hasGlass && 'sonic-screen']}>
						<sonic-waveform
							aria-labelledby={wave.id}
							class:list={[wave.sizeClass ?? '[--sonic-waveform-length:20rem]', wave.className]}
							data-bands={wave.bands}
							data-format="clock-tenths"
							data-markers={wave.markers ?? '146=Intro 151.5=Second_track 158=Outro~'}
							data-pending={wave.pending}
							data-samples={wave.seed}
							dimmed={wave.isDimmed}
							disabled={wave.isDisabled}
							inert={wave.isInert}
							key-step="1"
							max="300"
							playing={wave.isPlaying}
							readout
							step="0"
							style={wave.style ?? (wave.bands === undefined ? undefined : ramp(wave.bands))}
							value="150"
							zoom={wave.zoom}
						></sonic-waveform>
					</div>
				</Cell>
			))}
			{group.hasZoom ? (
				<Cell id="waveform-zoom" isStacked={true} label="Detail">
					<div class="contents" data-zoom-specimen>
						<sonic-waveform
							aria-labelledby="waveform-zoom"
							class="[--sonic-waveform-length:20rem]"
							data-format="clock-tenths"
							data-markers="146 151.5 158~"
							data-samples="12"
							key-step="1"
							max="300"
							playing={true}
							readout
							step="0"
							value="150"
						></sonic-waveform>
						<Cell id="waveform-zoom-buttons" label="Zoom">
							<sonic-button aria-label="Zoom in" data-zoom="1">
								<ZoomIn aria-hidden="true" />
							</sonic-button>
							<sonic-button aria-label="Zoom out" data-zoom="-1">
								<ZoomOut aria-hidden="true" />
							</sonic-button>
						</Cell>
					</div>
				</Cell>
			) : undefined}
		</SpecimenGrid>
	</Section>
))}

<script>
	import '#scripts/markers.ts';
	import '#scripts/samples.ts';
	import '#scripts/specimens/zoom.ts';
</script>
