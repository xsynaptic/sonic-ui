---
import ZoomIn from '@lucide/astro/icons/zoom-in';
import ZoomOut from '@lucide/astro/icons/zoom-out';

import Cell from '#components/specimens/cell.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const waveforms = [
	{ id: 'waveform-playing', isPlaying: true, label: 'Playing', seed: 7 },
	{ id: 'waveform-paused', label: 'Paused', seed: 8 },
	{ id: 'waveform-pending', label: 'Pending', pending: '151 162', seed: 9 },
	{ id: 'waveform-rate', isPlaying: true, label: 'Double speed', rate: 2, seed: 14 },
	{ format: 'seconds-tenths', id: 'waveform-seconds', label: 'Readout in seconds', seed: 15 },
	{
		className: [
			'[--sonic-waveform-playhead-width:1px] [--sonic-waveform-label-fade-end:0]',
			'[--sonic-waveform-label-font:ui-monospace,monospace] [--sonic-waveform-label-font-ratio:0.1]',
			'[--sonic-waveform-label-scrim:light-dark(rgb(255_255_255/60%),rgb(0_0_0/50%))]',
		].join(' '),
		id: 'waveform-tokens',
		label: 'Thin playhead, label tokens',
		pending: '153 162',
		seed: 16,
	},
	{
		id: 'waveform-scroll',
		isPlaying: true,
		label: 'Scrolls under reduced motion',
		motion: 'scroll',
		seed: 17,
	},
	{
		className: '[--sonic-waveform-label-fade-start:0.5]',
		id: 'waveform-late-fade',
		isPlaying: true,
		label: 'Drawn label, late fade',
		markers: '146=First_artist|Opening 151.5=Second_artist|Second_track 158=Third_artist|Outro~',
		seed: 18,
	},
	{ hasGlass: true, id: 'waveform-glass', isPlaying: true, label: 'On glass', seed: 19 },
	{ hasGlass: true, id: 'waveform-glass-paused', label: 'On glass, paused', seed: 20 },
	{
		hasGlass: true,
		id: 'waveform-glass-flat',
		label: 'On flat glass',
		screenClass: '[--sonic-glass-depth:0]',
		seed: 10,
	},
	{
		hasGlass: true,
		id: 'waveform-inert',
		isInert: true,
		isPlaying: true,
		label: 'Inert, a small display',
		markers: '',
		seed: 21,
		sizeClass: '[--sonic-waveform-length:6rem] [--sonic-waveform-size:2rem]',
		zoom: 96,
	},
];
---

<SpecimenGrid isLarge={true}>
	{waveforms.map((waveform) => (
		<Cell id={waveform.id} isWide={true} label={waveform.label}>
			<div class:list={[waveform.hasGlass && 'sonic-screen', waveform.screenClass]}>
				<sonic-waveform
					aria-labelledby={waveform.id}
					class:list={[waveform.sizeClass ?? '[--sonic-waveform-length:20rem]', waveform.className]}
					data-format={waveform.format ?? 'clock-tenths'}
					data-markers={waveform.markers ?? '146=Intro 151.5=Second_track 158=Outro~'}
					data-pending={waveform.pending}
					data-samples={waveform.seed}
					inert={waveform.isInert}
					key-step="1"
					max="300"
					playback-rate={waveform.rate}
					playing={waveform.isPlaying}
					readout
					reduced-motion={waveform.motion}
					step="0"
					value="150"
					zoom={waveform.zoom}
				></sonic-waveform>
			</div>
		</Cell>
	))}
	<Cell id="waveform-zoom" isWide={true} label="Zoom">
		<div class="flex flex-col items-center gap-2 sm:flex-row" data-zoom-specimen>
			<sonic-waveform
				aria-labelledby="waveform-zoom"
				class="[--sonic-waveform-length:20rem]"
				data-format="clock-tenths"
				data-markers="146 151.5 158~"
				data-samples="12"
				key-step="1"
				max="300"
				playing={true}
				readout
				step="0"
				value="150"
			></sonic-waveform>
			<div class="flex gap-1 [--sonic-button-size:1.5rem] sm:flex-col">
				<sonic-button aria-label="Zoom in" data-zoom="1">
					<ZoomIn aria-hidden="true" />
				</sonic-button>
				<sonic-button aria-label="Zoom out" data-zoom="-1">
					<ZoomOut aria-hidden="true" />
				</sonic-button>
			</div>
		</div>
	</Cell>
</SpecimenGrid>
