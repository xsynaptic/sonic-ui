---
import ZoomIn from '@lucide/astro/icons/zoom-in';
import ZoomOut from '@lucide/astro/icons/zoom-out';

import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';
import { tonalTint } from '#scripts/specimens/tonal-tint.ts';

interface Wave {
	bands?: number;
	className?: string;
	dynamics?: 'energy' | 'onsets';
	hasGlass?: boolean;
	hue?: 'spectral';
	id: string;
	isDimmed?: boolean;
	isDisabled?: boolean;
	isInert?: boolean;
	isPlaying?: boolean;
	label: string;
	markers?: string;
	pending?: string;
	rms?: boolean;
	seed: number;
	sizeClass?: string;
	style?: string;
	zoom?: number;
}

function palette(...stops: Array<string>): string {
	return stops
		.map((stop, index) => `--sonic-waveform-tint-${String(index + 1)}: ${stop}`)
		.join('; ');
}

const spectrum = palette('oklch(0.66 0.2 28)', 'oklch(0.8 0.17 85)', 'oklch(0.74 0.13 210)');
const amber = palette('oklch(0.46 0.14 48)', 'oklch(0.72 0.17 58)', 'oklch(0.93 0.06 70)');
const ice = palette('oklch(0.42 0.14 262)', 'oklch(0.68 0.15 240)', 'oklch(0.94 0.05 210)');
const heat = palette('oklch(0.5 0.17 30)', 'oklch(0.72 0.18 55)', 'oklch(0.92 0.08 92)');

const groups: Array<{ hasZoom?: boolean; title: string; waves: Array<Wave> }> = [
	{
		hasZoom: true,
		title: 'Playback',
		waves: [
			{ id: 'waveform-playing', isPlaying: true, label: 'Track', seed: 7 },
			{
				className: '[--sonic-waveform-label-fade-start:0.5]',
				id: 'waveform-mix',
				isPlaying: true,
				label: 'Mix',
				markers:
					'146=First_artist|Opening 151.5=Second_artist|Second_track 158=Third_artist|Outro~',
				seed: 18,
			},
		],
	},
	{
		title: 'Tint',
		waves: [
			{
				dynamics: 'energy',
				id: 'waveform-energy',
				isPlaying: true,
				label: 'Drops',
				rms: true,
				seed: 31,
				style: amber,
			},
			{
				bands: 3,
				dynamics: 'onsets',
				id: 'waveform-transients',
				isPlaying: true,
				label: 'Hits',
				rms: true,
				seed: 22,
				style: ice,
			},
			{
				bands: 3,
				hue: 'spectral',
				id: 'waveform-spectral',
				isPlaying: true,
				label: 'Timbre',
				rms: true,
				seed: 28,
				style: spectrum,
			},
			{
				bands: 3,
				dynamics: 'energy',
				hue: 'spectral',
				id: 'waveform-spectral-energy',
				isPlaying: true,
				label: 'Timbre and drops',
				rms: true,
				seed: 33,
				style: spectrum,
			},
			{
				bands: 3,
				dynamics: 'onsets',
				hasGlass: true,
				hue: 'spectral',
				id: 'waveform-spectral-transients',
				isPlaying: true,
				label: 'Timbre and hits',
				rms: true,
				seed: 34,
				style: tonalTint,
			},
			{
				bands: 3,
				hue: 'spectral',
				id: 'waveform-stepped',
				isPlaying: true,
				label: 'Sections',
				rms: true,
				seed: 35,
				style: `${heat}; --sonic-waveform-tint-steps: 3`,
			},
		],
	},
	{
		title: 'RMS',
		waves: [{ id: 'waveform-rms', isPlaying: true, label: 'Master', rms: true, seed: 31 }],
	},
	{
		title: 'Glass',
		waves: [
			{ hasGlass: true, id: 'waveform-glass', isPlaying: true, label: 'Deck', seed: 19 },
			{
				hasGlass: true,
				id: 'waveform-inert',
				isInert: true,
				isPlaying: true,
				label: 'Thumbnail',
				markers: '',
				seed: 21,
				sizeClass: '[--sonic-waveform-length:6rem] [--sonic-waveform-size:2rem]',
				zoom: 96,
			},
		],
	},
	{
		title: 'States',
		waves: [
			{ id: 'waveform-pending', label: 'Pending', pending: '151 162', seed: 9 },
			{
				bands: 3,
				hue: 'spectral',
				id: 'waveform-dimmed',
				isDimmed: true,
				label: 'Dimmed',
				rms: true,
				seed: 24,
				style: spectrum,
			},
			{
				bands: 3,
				hue: 'spectral',
				id: 'waveform-disabled',
				isDisabled: true,
				label: 'Disabled',
				rms: true,
				seed: 25,
				style: spectrum,
			},
		],
	},
];
---

{groups.map((group) => (
	<Section title={group.title}>
		<SpecimenGrid size="wide">
			{group.waves.map((wave) => (
				<Cell id={wave.id} label={wave.label}>
					<div class:list={[wave.hasGlass && 'sonic-screen']}>
						<sonic-waveform
							aria-labelledby={wave.id}
							class:list={[wave.sizeClass ?? '[--sonic-waveform-length:20rem]', wave.className]}
							data-bands={wave.bands}
							data-format="clock-tenths"
							data-markers={wave.markers ?? '146=Intro 151.5=Second_track 158=Outro~'}
							data-pending={wave.pending}
							data-rms={wave.rms}
							data-samples={wave.seed}
							dimmed={wave.isDimmed}
							disabled={wave.isDisabled}
							inert={wave.isInert}
							key-step="1"
							max="300"
							playing={wave.isPlaying}
							readout={true}
							step="0"
							style={wave.style}
							tint-dynamics={wave.dynamics}
							tint-hue={wave.hue}
							value="150"
							zoom={wave.zoom}
						></sonic-waveform>
					</div>
				</Cell>
			))}
			{group.hasZoom ? (
				<Cell id="waveform-zoom" isStacked={true} label="Detail">
					<div class="contents" data-zoom-specimen={true}>
						<sonic-waveform
							aria-labelledby="waveform-zoom"
							class="[--sonic-waveform-length:20rem]"
							data-format="clock-tenths"
							data-markers="146 151.5 158~"
							data-samples="12"
							key-step="1"
							max="300"
							playing={true}
							readout={true}
							step="0"
							value="150"
						></sonic-waveform>
						<Cell id="waveform-zoom-buttons" label="Zoom">
							<sonic-button aria-label="Zoom in" data-zoom="1">
								<ZoomIn aria-hidden="true" />
							</sonic-button>
							<sonic-button aria-label="Zoom out" data-zoom="-1">
								<ZoomOut aria-hidden="true" />
							</sonic-button>
						</Cell>
					</div>
				</Cell>
			) : undefined}
		</SpecimenGrid>
	</Section>
))}

<script>
	import '#scripts/markers.ts';
	import '#scripts/samples.ts';
	import '#scripts/specimens/zoom.ts';
</script>
