---
import Lock from '@lucide/astro/icons/lock';

import Cell from '#components/specimens/cell.astro';
import Panel from '#components/specimens/panel.astro';

const faders = [
	{ id: 'sum-a', label: 'A', value: 50 },
	{ id: 'sum-b', label: 'B', value: 30 },
	{ id: 'sum-c', label: 'C', value: 20 },
];
const modes = [
	['proportional', 'Share'],
	['equal', 'Equal'],
	['cascade', 'Next'],
] as const;
---

<Panel>
	<div class="col-span-full grid justify-items-center gap-6" data-sum-demo>
		<sonic-segmented aria-label="Mode" class="font-mono" data-sum-mode value="proportional">
			{modes.map(([value, label]) => (
				<span data-sonic-value={value}>{label}</span>
			))}
		</sonic-segmented>
		<sonic-sum aria-label="Three-way split" class="flex gap-8">
			{faders.map((fader) => (
				<div class="grid justify-items-center gap-2">
					<sonic-slider
						aria-labelledby={fader.id}
						class="[--sonic-slider-length:9rem]"
						orientation="vertical"
						value={fader.value}
					></sonic-slider>
					<span
						aria-hidden="true"
						class="sonic-screen font-mono text-xs tabular-nums [--sonic-screen-aspect-ratio:2] [--sonic-screen-size:1.25rem]"
						data-sum-readout
					>
						{fader.value}
					</span>
					<sonic-key aria-label={`Lock ${fader.label}`} data-sum-lock toggle>
						<Lock aria-hidden="true" />
					</sonic-key>
					<span
						class="font-mono text-[0.625rem] tracking-[0.14em] text-zinc-400 uppercase"
						id={fader.id}
					>
						{fader.label}
					</span>
				</div>
			))}
		</sonic-sum>
	</div>
</Panel>
<Panel isLarge={true}>
	<sonic-sum
		aria-label="Mixed members"
		class="col-span-full flex flex-wrap items-end justify-center gap-8"
		total="150"
	>
		<Cell id="sum-dial" label="Dial">
			<sonic-dial aria-labelledby="sum-dial" readout value="60"></sonic-dial>
		</Cell>
		<Cell id="sum-slider" isWide={true} label="Slider">
			<sonic-slider aria-labelledby="sum-slider" readout value="50"></sonic-slider>
		</Cell>
		<Cell id="sum-number" label="Number">
			<sonic-number aria-labelledby="sum-number" class="font-mono" value="40"></sonic-number>
		</Cell>
	</sonic-sum>
</Panel>
