---
import Cell from '#components/specimens/cell.astro';
import Section from '#components/specimens/section.astro';
import SpecimenGrid from '#components/specimens/specimen-grid.astro';

const long = 'A long title that runs well past the end of the box it sits in';
---

<Section title="Text">
	<SpecimenGrid size="wide">
		<Cell id="ticker-short" label="Album">
			<div class="w-64 max-w-full text-sm text-text-strong">
				<sonic-ticker>A short title</sonic-ticker>
			</div>
		</Cell>
		<Cell id="ticker-long" label="Track title">
			<div class="w-64 max-w-full text-sm text-text-strong">
				<sonic-ticker data-ticker>{long}</sonic-ticker>
			</div>
		</Cell>
		<Cell id="ticker-screen" label="Now playing">
			<div class="sonic-screen w-64 max-w-full font-mono text-sm">
				<sonic-ticker data-ticker>{long}</sonic-ticker>
			</div>
		</Cell>
		<Cell id="ticker-link" label="Artist">
			<div class="w-64 max-w-full text-sm text-text-strong">
				<sonic-ticker data-ticker>
					A long title that runs well past the end of the box, with{' '}
					<a class="underline" href="#text">
						a link
					</a>
				</sonic-ticker>
			</div>
		</Cell>
		<Cell id="ticker-cancellable" label="Station">
			<div class="w-64 max-w-full text-sm text-text-strong">
				<sonic-ticker cancellable data-ticker>
					{long}
				</sonic-ticker>
			</div>
		</Cell>
	</SpecimenGrid>
</Section>

<script>
	import '#scripts/specimens/ticker.ts';
</script>
