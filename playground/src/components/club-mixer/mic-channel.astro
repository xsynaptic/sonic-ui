---
import ChannelFader from '#components/club-mixer/channel-fader.astro';
import StripInput from '#components/club-mixer/strip-input.astro';
import Label from '#components/replica/label.astro';
import PanelKey from '#components/replica/panel-key.astro';
import PanelLever from '#components/replica/panel-lever.astro';
import Pot from '#components/replica/pot.astro';

interface Props {
	channel: number;
	fader: number;
}

const { channel, fader } = Astro.props;

const strip = `mic-${String(channel)}`;
const talk = [
	{ isMomentary: true, text: 'Duck', value: 'duck' },
	{ text: 'Off', value: 'off' },
	{ text: 'On', value: 'on' },
];
const bands = [
	{ id: 'high', label: 'High' },
	{ id: 'mid-high', label: 'Mid hi' },
	{ id: 'mid-low', label: 'Mid lo' },
	{ id: 'low', label: 'Low' },
];
---

<div
	aria-label={`Mic ${String(channel)}`}
	class="flex flex-col items-center gap-2.5 px-1.5"
	data-mic={channel}
	role="group"
>
	<StripInput input="Return" level={0} strip={strip} />
	{bands.map((band) => (
		<Pot
			detent={0}
			ends={['−15', '+15']}
			format="db"
			id={`${strip}-${band.id}`}
			label={band.label}
			max={15}
			min={-15}
			origin={0}
			value={0}
		/>
	))}
	<PanelKey
		data={{ 'data-cue': '' }}
		id={`${strip}-cue`}
		isRound={true}
		label="Cue"
		size="medium"
	/>
	<PanelLever
		data={{ 'data-mic-switch': '' }}
		id={`${strip}-switch`}
		label="Mic"
		positions={talk}
		value="on"
	/>
	<div class="grid justify-items-center gap-1">
		<span class="sonic-led" data-mic-led></span>
		<Label id={`${strip}-on`} text="On" />
	</div>
	<span aria-hidden="true" class="font-mono text-base font-bold text-zinc-300">
		{channel}
	</span>
	<ChannelFader hasMeter={false} value={fader} />
</div>
