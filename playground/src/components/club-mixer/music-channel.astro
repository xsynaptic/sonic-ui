---
import ChannelFader from '#components/club-mixer/channel-fader.astro';
import StripInput from '#components/club-mixer/strip-input.astro';
import PanelButton from '#components/replica/panel-button.astro';
import PanelDial from '#components/replica/panel-dial.astro';
import PanelSwitch from '#components/replica/panel-switch.astro';

interface Props {
	channel: number;
	fader: number;
	level: number;
}

const { channel, fader, level } = Astro.props;

const side = channel < 3 ? 'x' : 'y';

const strip = `channel-${String(channel)}`;
const filterAssign = [
	{ text: '1', value: '1' },
	{ text: 'Off', value: 'off' },
	{ text: '2', value: '2' },
];
const crossfadeAssign = [
	{ text: 'X', value: 'x' },
	{ text: 'Off', value: 'off' },
	{ text: 'Y', value: 'y' },
];
const bands = [
	{ id: 'high', label: 'High', low: '∞', min: -60 },
	{ id: 'mid-high', label: 'Mid hi', low: '−30', min: -30 },
	{ id: 'mid-low', label: 'Mid lo', low: '−30', min: -30 },
	{ id: 'low', label: 'Low', low: '∞', min: -60 },
];
---

<div
	aria-label={`Channel ${String(channel)}`}
	class="flex flex-col items-center gap-2.5 border-s border-line px-2.5"
	data-channel={channel}
	role="group"
>
	<StripInput input="Line" level={level} levelData={{ 'data-channel-level': '' }} strip={strip} />
	{bands.map((band) => (
		<PanelDial
			detent={0}
			ends={[band.low, '+6']}
			format="db-kill"
			id={`${strip}-${band.id}`}
			label={band.label}
			max={6}
			midpoint={0}
			min={band.min}
			origin={0}
			size="medium"
			ticks={[-24, -12, -6, 0, 3]}
			value={0}
		/>
	))}
	<PanelSwitch
		id={`${strip}-filter`}
		isHorizontal={true}
		label="Filter"
		positions={filterAssign}
		value="off"
	/>
	<PanelSwitch
		data={{ 'data-crossfade-assign': '' }}
		id={`${strip}-crossfade`}
		isHorizontal={true}
		label="X fade"
		positions={crossfadeAssign}
		value={side}
	/>
	<PanelButton
		data={{ 'data-cue': '' }}
		id={`${strip}-cue`}
		isRound={true}
		label="Cue"
		size="large"
	/>
	<span aria-hidden="true" class="font-mono text-base font-bold text-text">
		{channel}
	</span>
	<ChannelFader hasMeter={true} value={fader} />
</div>
