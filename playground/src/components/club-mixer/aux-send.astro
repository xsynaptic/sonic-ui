---
import MixerKey from '#components/club-mixer/mixer-key.astro';
import Pot from '#components/club-mixer/pot.astro';

interface Props {
	send: 1 | 2;
	strip: string;
}

const { send, strip } = Astro.props;

const id = `${strip}-aux-${String(send)}`;
---

<div class="flex items-center gap-1.5">
	<Pot
		ends={['∞', '+6']}
		format="db-kill"
		id={id}
		label={`Aux ${String(send)}`}
		max={6}
		midpoint={-12}
		min={-60}
		ticks={[-30, -20, -12, -6, 0]}
		value={-60}
	/>
	<MixerKey hasLed={false} id={`${id}-pre`} label="Pre" labelledby={`${id} ${id}-pre`} />
</div>
