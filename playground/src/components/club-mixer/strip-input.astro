---
import AuxSend from '#components/club-mixer/aux-send.astro';
import PanelButton from '#components/replica/panel-button.astro';
import PanelDial from '#components/replica/panel-dial.astro';

interface Props {
	input: string;
	level: number;
	levelData?: Record<string, string>;
	strip: string;
}

const { input, level, levelData = {}, strip } = Astro.props;
---

<AuxSend send={1} strip={strip} />
<AuxSend send={2} strip={strip} />
<PanelButton hasTwoColourLed={true} id={`${strip}-${input.toLowerCase()}`} label={input} />
<PanelDial
	data={levelData}
	detent={0}
	ends={['∞', '+10']}
	format="db-kill"
	id={`${strip}-level`}
	label="Level"
	max={10}
	midpoint={0}
	min={-60}
	ticks={[-30, -20, -10, 0, 5]}
	value={level}
/>
