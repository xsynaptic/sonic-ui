---
interface Props {
	bodyClass?: string;
	title: string;
}

const { bodyClass, title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<link href="data:," rel="icon" />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>
