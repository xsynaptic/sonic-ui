---
import { Font } from 'astro:assets';

interface Props {
	bodyClass?: string;
	description?: string;
	scheme?: 'dark' | 'light';
	skin?: string;
	title: string;
}

const { bodyClass, description, scheme, skin, title } = Astro.props;

// The wordmark's dial, with heavier strokes so it reads at 16px
const favicon = `data:image/svg+xml,${encodeURIComponent(
	'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none" stroke-linecap="round" stroke-width="3.5"><style>.ink{stroke:#18181b}@media (prefers-color-scheme:dark){.ink{stroke:#f4f4f5}}</style><path class="ink" d="M24.7 6.34A13 13 0 0 1 22.5 27.26" opacity=".3"/><path d="M9.5 27.26A13 13 0 1 1 24.7 6.34" stroke="#f59e0a"/><path class="ink" d="M18.34 13.4 21.35 10.05" stroke-width="3"/></svg>',
)}`;
---

<!doctype html>
<html class={skin ? `sonic-skin-${skin}` : undefined} data-scheme={scheme} lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		{description ? <meta content={description} name="description" /> : undefined}
		<meta content="#f4f4f5" media="(prefers-color-scheme: light)" name="theme-color" />
		<meta content="#09090b" media="(prefers-color-scheme: dark)" name="theme-color" />
		<link href={favicon} rel="icon" type="image/svg+xml" />
		<Font cssVariable="--font-plex-sans" preload={[{ subset: 'latin', weight: 400 }]} />
		<Font cssVariable="--font-plex-mono" />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>
