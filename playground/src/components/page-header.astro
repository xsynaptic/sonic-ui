---
import type { Usage } from '#scripts/controls.ts';

interface Props {
	title: string;
	usage?: ReadonlyArray<Usage>;
}

const { title, usage = [] } = Astro.props;

function usageLine(entry: Usage): ReadonlyArray<string> {
	if ('className' in entry) return [`.${entry.className}`, entry.sheet];

	const line = [`<${entry.tag}>`, entry.define];
	if (entry.sheet !== undefined) line.push(entry.sheet);

	return line;
}
---

<header class="mb-8 max-w-2xl">
	<h1 class="text-2xl font-semibold tracking-tight text-text-strong">{title}</h1>
	<p class="mt-2 leading-relaxed text-text-muted">
		<slot name="lead" />
	</p>
	{usage.length > 0 ? (
		<div class="mt-3 grid gap-1 font-mono text-[0.8125rem] text-text">
			{usage.map((entry) => (
				<p class="flex flex-wrap gap-x-5 gap-y-1">
					{usageLine(entry).map((part) => (
						<code>{part}</code>
					))}
				</p>
			))}
		</div>
	) : undefined}
	<slot />
</header>
