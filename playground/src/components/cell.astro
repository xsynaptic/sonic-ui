---
interface Props {
	id: string;
	isWide?: boolean;
	label: string;
}

const { id, isWide = false, label } = Astro.props;
---

<div
	class:list={['grid grid-rows-[1fr_auto] justify-items-center gap-3', { 'col-span-2': isWide }]}
>
	<div class="flex items-center justify-center gap-2">
		<slot />
	</div>
	<span
		class="font-mono text-[0.625rem] tracking-[0.14em] text-zinc-400 uppercase [text-shadow:0_-1px_0_rgb(0_0_0/60%)]"
		id={id}
	>
		{label}
	</span>
</div>
