---
import Label from '#components/replica/label.astro';

interface Props {
	data?: Record<string, string>;
	hasLed?: boolean;
	hasTwoColourLed?: boolean;
	id: string;
	isMomentary?: boolean;
	isPressed?: boolean;
	isRound?: boolean;
	label: string;
	labelledby?: string;
	size?: 'large' | 'medium' | 'small';
}

const {
	data = {},
	hasLed = true,
	hasTwoColourLed = false,
	id,
	isMomentary = false,
	isPressed = false,
	isRound = false,
	label,
	labelledby = id,
	size = 'small',
} = Astro.props;

const sizeClass = {
	large: '[--sonic-key-size:2.5rem]',
	medium: '[--sonic-key-size:1.75rem]',
	small: '[--sonic-key-size:1.25rem]',
}[size];

// Astro writes `false` as a string, which still sets a boolean attribute
const mode = isMomentary ? { momentary: '' } : { toggle: '' };
---

<div
	class:list={[
		'grid justify-items-center gap-1',
		sizeClass,
		{ '[--sonic-key-face-radius-ratio:0.5] [--sonic-key-radius-ratio:0.5]': isRound },
	]}
>
	{hasTwoColourLed ? (
		<sonic-key
			aria-labelledby={labelledby}
			data-two-colour
			pressed={isPressed ? '' : undefined}
			{...mode}
			{...data}
		>
			<span class="sonic-led" data-sonic-lit="alt"></span>
		</sonic-key>
	) : (
		<sonic-key
			aria-labelledby={labelledby}
			pressed={isPressed ? '' : undefined}
			{...mode}
			{...data}
		>
			{hasLed ? <span class="sonic-led"></span> : undefined}
		</sonic-key>
	)}
	<Label id={id} text={label} />
</div>
