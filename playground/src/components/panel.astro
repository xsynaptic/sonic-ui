---
interface Props {
	isLarge?: boolean;
}

const { isLarge = false } = Astro.props;
---

<div
	class:list={[
		'rounded-lg border border-zinc-800 bg-zinc-900 p-5 shadow-[inset_0_1px_0_rgb(255_255_255/4%)]',
		{ 'mt-3': isLarge },
	]}
>
	<div
		class:list={[
			'grid gap-x-4 gap-y-6',
			isLarge
				? 'grid-cols-[repeat(auto-fill,minmax(12rem,1fr))]'
				: 'grid-cols-[repeat(auto-fill,minmax(6.5rem,1fr))]',
		]}
	>
		<slot />
	</div>
</div>
