---
import Document from '#components/document.astro';
import '#styles/playground.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

const pages = [
	{ href: '/', label: 'Specimens' },
	{ href: '/club-mixer/', label: 'Club mixer' },
	{ href: '/tape-echo/', label: 'Tape echo' },
	{ href: '/web-player/', label: 'Web player' },
];
const skins = ['default', 'slate', 'lime', 'ivory', 'flat', 'bare'];
---

<Document bodyClass="bg-zinc-950 text-zinc-300 antialiased" title={title}>
	<script is:inline slot="head">
		try {
			const skin = localStorage.getItem('sonic-playground-skin');

			if (skin && skin !== 'default') document.documentElement.classList.add(`sonic-skin-${skin}`);
		} catch {
			// Private windows can refuse storage
		}
	</script>
	<nav class="sticky top-0 z-10 border-b border-zinc-800 bg-zinc-950/90 backdrop-blur">
		<div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-2 sm:px-8">
			<a class="font-mono text-sm font-bold text-zinc-100" href="/">
				sonic-ui
			</a>
			<ul aria-label="Pages" class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs">
				{pages.map((page) => (
					<li>
						<a
							aria-current={Astro.url.pathname === page.href ? 'page' : undefined}
							class="inline-flex min-h-6 items-center text-zinc-400 underline-offset-4 hover:text-zinc-100 aria-[current=page]:text-zinc-100 aria-[current=page]:underline"
							href={page.href}
						>
							{page.label}
						</a>
					</li>
				))}
			</ul>
			<div class="ms-auto font-mono [--sonic-segmented-size:1.75rem]">
				<sonic-segmented aria-label="Skin" data-skin-choice value="default">
					{skins.map((skin) => (
						<span data-sonic-value={skin}>{skin}</span>
					))}
				</sonic-segmented>
			</div>
		</div>
	</nav>
	<main class="mx-auto max-w-6xl px-4 py-10 sm:px-8" id="top">
		<slot />
	</main>
	<script>
		import '@xsynaptic/sonic-ui/define';

		import '#scripts/skin.ts';
		import '#scripts/formats.ts';
	</script>
	<slot name="scripts" />
</Document>
