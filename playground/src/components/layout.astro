---
import Monitor from '@lucide/astro/icons/monitor';
import Moon from '@lucide/astro/icons/moon';
import Sun from '@lucide/astro/icons/sun';

import Document from '#components/document.astro';
import '#styles/playground.css';

interface Props {
	description: string;
	title: string;
}

const { description, title } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pages = [
	{ href: `${base}/`, label: 'Specimens' },
	{ href: `${base}/club-mixer/`, label: 'Club mixer' },
	{ href: `${base}/tape-echo/`, label: 'Tape echo' },
	{ href: `${base}/web-player/`, label: 'Web player' },
];
const skins = ['default', 'flat', 'amber', 'slate', 'lime', 'ivory'];
const schemes = [
	{ Icon: Monitor, label: 'System', value: 'system' },
	{ Icon: Sun, label: 'Light', value: 'light' },
	{ Icon: Moon, label: 'Dark', value: 'dark' },
];
const linkClass =
	'inline-flex min-h-6 items-center text-text-muted underline-offset-4 hover:text-text-strong';
---

<Document bodyClass="bg-ground text-text antialiased" description={description} title={title}>
	<script is:inline slot="head">
		try {
			const skin = localStorage.getItem('sonic-playground-skin');
			const scheme = localStorage.getItem('sonic-playground-scheme');

			if (skin && skin !== 'default') document.documentElement.classList.add(`sonic-skin-${skin}`);
			if (scheme === 'light' || scheme === 'dark') document.documentElement.dataset.scheme = scheme;
		} catch {
			// Private windows can refuse storage
		}
	</script>
	<nav class="top-0 sm:sticky z-10 border-b border-line bg-ground/90 backdrop-blur">
		<div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-2 sm:px-8">
			<a class="font-mono text-sm font-bold text-text-strong" href={`${base}/`}>
				sonic-ui
			</a>
			<ul aria-label="Pages" class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
				{pages.map((page) => (
					<li>
						<a
							aria-current={Astro.url.pathname === page.href ? 'page' : undefined}
							class:list={[
								linkClass,
								'aria-[current=page]:text-text-strong aria-[current=page]:underline',
							]}
							href={page.href}
						>
							{page.label}
						</a>
					</li>
				))}
				<li>
					<a class={linkClass} href="https://github.com/xsynaptic/sonic-ui">
						GitHub
					</a>
				</li>
			</ul>
			<div class="ms-auto flex flex-wrap items-center gap-x-3 gap-y-2 font-mono [--sonic-segmented-size:1.75rem]">
				<sonic-segmented aria-label="Skin" data-skin-choice value="default">
					{skins.map((skin) => (
						<span data-sonic-value={skin}>{skin}</span>
					))}
				</sonic-segmented>
				<sonic-segmented aria-label="Colour scheme" data-scheme-choice value="system">
					{schemes.map(({ Icon, label, value }) => (
						<Icon aria-label={label} data-sonic-value={value} role="img" />
					))}
				</sonic-segmented>
			</div>
		</div>
	</nav>
	<main class="mx-auto max-w-6xl px-4 py-10 sm:px-8" id="top">
		<slot />
	</main>
	<script>
		import '@xsynaptic/sonic-ui/define';

		import '#scripts/skin.ts';
		import '#scripts/formats.ts';
	</script>
	<slot name="scripts" />
</Document>
