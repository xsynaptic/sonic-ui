---
import Cell from '#components/cell.astro';
import Panel from '#components/panel.astro';
---

<Panel>
	<Cell id="number-tempo" isWide={true} label="Tempo">
		<sonic-number
			aria-labelledby="number-tempo"
			class="font-mono"
			data-format="bpm"
			default="120"
			max="300"
			min="20"
			step="0.1"
			value="120"
		></sonic-number>
	</Cell>
	<Cell id="number-frequency" isWide={true} label="Frequency">
		<sonic-number
			aria-labelledby="number-frequency"
			class="font-mono"
			data-format="hertz"
			max="20000"
			min="20"
			taper="log"
			value="440"
		></sonic-number>
	</Cell>
	<Cell id="number-transpose" isWide={true} label="Transpose">
		<sonic-number
			aria-labelledby="number-transpose"
			class="font-mono"
			data-format="semitones"
			default="0"
			double-press="reset"
			max="24"
			min="-24"
			value="-5"
		></sonic-number>
	</Cell>
	<Cell id="number-loop" isWide={true} label="Loop">
		<sonic-number
			aria-labelledby="number-loop"
			class="font-mono"
			data-format="beats"
			value="4"
			values="0.03125 0.0625 0.125 0.25 0.5 1 2 4 8 16 32"
		></sonic-number>
	</Cell>
	<Cell id="number-note" isWide={true} label="Note">
		<sonic-number
			aria-labelledby="number-note"
			class="font-mono"
			data-format="note"
			value="48"
			values="3 6 8 12 16 18 24 32 36 48 64 72 96 144 192"
		></sonic-number>
	</Cell>
	<Cell id="number-disabled" isWide={true} label="Disabled">
		<sonic-number
			aria-labelledby="number-disabled"
			class="font-mono"
			data-format="percent"
			disabled
			value="60"
		></sonic-number>
	</Cell>
</Panel>
<Panel isLarge={true}>
	<Cell id="number-large-tempo" isWide={true} label="Tempo, large">
		<sonic-number
			aria-labelledby="number-large-tempo"
			class="font-mono [--sonic-number-size:3.5rem]"
			data-format="bpm"
			default="120"
			max="300"
			min="20"
			step="0.1"
			value="120"
		></sonic-number>
	</Cell>
</Panel>
