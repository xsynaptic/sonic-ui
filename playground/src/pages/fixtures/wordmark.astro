---
import Document from '#components/document.astro';
import Wordmark from '#components/wordmark.astro';
import '#styles/playground.css';

const grounds = [
	{ name: 'light', style: 'color-scheme:light;background:#fff;color:#09090b' },
	{ name: 'dark', style: 'color-scheme:dark;background:#000;color:#f4f4f5' },
];
---

<Document title="sonic-ui fixtures, wordmark">
	<main>
		<h1 class="sr-only">Wordmark</h1>
		{grounds.map((ground) => (
			<div class="p-16" data-ground style={ground.style}>
				<div class="inline-flex p-[0.12em] text-[6rem] leading-none" data-wordmark={ground.name}>
					<Wordmark />
				</div>
			</div>
		))}
	</main>
	<script>
		import '@xsynaptic/sonic-ui/define/dial';
	</script>
</Document>
