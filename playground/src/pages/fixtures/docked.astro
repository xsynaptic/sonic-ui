---
import Document from '#components/document.astro';
import '#styles/playground.css';

// `backdrop-filter` makes the bar the containing block for fixed-position descendants
// A closed readout left rendered once flipped below a dial near the bar's top edge
---

<Document
	bodyClass="bg-ground text-text"
	scheme="dark"
	skin="amber"
	title="sonic-ui fixtures, docked bar"
>
	<main class="p-16">
		<h1>Docked bar</h1>
		<div class="h-[300vh]"></div>
		<div class="sticky bottom-40">
			<div class="relative flex items-start bg-surface/70 p-2 backdrop-blur-sm">
				<sonic-dial aria-label="Level" id="sticky" readout value="50"></sonic-dial>
			</div>
		</div>
	</main>
	<footer class="fixed inset-x-0 bottom-0 flex items-start bg-surface/70 px-16 pt-2 pb-20 backdrop-blur-sm">
		<sonic-dial aria-label="Volume" id="docked" readout value="50"></sonic-dial>
	</footer>
	<script>
		import '@xsynaptic/sonic-ui/define/dial';
	</script>
</Document>
