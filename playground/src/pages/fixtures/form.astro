---
import Document from '#components/document.astro';
import '#styles/playground.css';
---

<Document bodyClass="bg-zinc-950 text-zinc-300" title="sonic-ui fixtures, form">
	<main class="p-16">
		<h1 class="sr-only">Form</h1>
		<form class="flex flex-wrap items-center gap-16" id="patch">
			<label for="cutoff">Cutoff</label>
			<sonic-dial id="cutoff" name="cutoff" step="5" value="40"></sonic-dial>
			<label class="grid justify-items-center gap-2">
				<span>Send</span>
				<sonic-slider id="send" name="send" value="30"></sonic-slider>
			</label>
			<label for="tempo">Tempo</label>
			<sonic-number id="tempo" max="300" name="tempo" step="0.5" value="120"></sonic-number>
			<label class="grid justify-items-center gap-2">
				<span>Mute</span>
				<sonic-button id="mute" latching name="mute">
					<span aria-hidden="true">M</span>
				</sonic-button>
			</label>
			<sonic-button aria-label="Solo" id="solo" latching name="solo" pressed value="yes">
				S
			</sonic-button>
			<sonic-button aria-label="Kick" id="kick" momentary name="kick"></sonic-button>
			<label for="mode">Mode</label>
			<sonic-segmented id="mode" name="mode" value="lp">
				<span data-sonic-value="lp">LP</span>
				<span data-sonic-value="hp">HP</span>
			</sonic-segmented>
			<label for="sync">Sync</label>
			<sonic-switch id="sync" name="sync"></sonic-switch>
			<sonic-switch aria-label="Assign" id="assign" name="assign" value="x">
				<span data-sonic-value="x">X</span>
				<span data-sonic-value="off">Off</span>
				<span data-sonic-value="y">Y</span>
			</sonic-switch>
			<sonic-dial aria-label="Held" disabled id="held" value="50"></sonic-dial>
			<sonic-dial id="late" name="late" value="10"></sonic-dial>
			<fieldset disabled id="rack">
				<legend>Rack</legend>
				<sonic-dial aria-label="Drive" id="drive" name="drive" value="50"></sonic-dial>
			</fieldset>
			<label for="touch">Touch</label>
			<sonic-xy id="touch" name="touch" x="40" x-step="5" y="60"></sonic-xy>
			<sonic-wavestrip
				aria-label="Position"
				id="position"
				max="300"
				name="position"
				step="5"
				value="150"
			></sonic-wavestrip>
			<sonic-waveform
				aria-label="Detail"
				id="detail"
				max="300"
				name="detail"
				step="2"
				value="90"
			></sonic-waveform>
		</form>
	</main>
	<script>
		import '@xsynaptic/sonic-ui/define';
	</script>
</Document>
