---
import Document from '#components/document.astro';
import '#styles/playground.css';
---

<Document bodyClass="bg-zinc-950 text-zinc-300" title="sonic-ui fixtures, mirrored children">
	<main class="flex flex-wrap items-center gap-16 p-16">
		<h1 class="sr-only">Mirrored children</h1>
		<sonic-key aria-label="Gradient" id="gradient">
			<svg height="16" viewBox="0 0 10 10" width="16">
				<linearGradient id="paint">
					<stop stop-color="#00ff00"></stop>
				</linearGradient>
				<rect fill="url(#paint)" height="10" width="10"></rect>
			</svg>
		</sonic-key>
		<svg height="16" id="gradient-twin" viewBox="0 0 10 10" width="16">
			<linearGradient id="paint">
				<stop stop-color="#00ff00"></stop>
			</linearGradient>
			<rect fill="url(#paint)" height="10" width="10"></rect>
		</svg>
		<sonic-key aria-label="Use" id="use">
			<svg height="16" viewBox="0 0 10 10" width="16">
				<defs>
					<rect height="10" id="shape" width="10"></rect>
				</defs>
				<use fill="#00ff00" href="#shape"></use>
			</svg>
		</sonic-key>
		<svg height="16" id="use-twin" viewBox="0 0 10 10" width="16">
			<defs>
				<rect height="10" id="shape" width="10"></rect>
			</defs>
			<use fill="#00ff00" href="#shape"></use>
		</svg>
		<sonic-key aria-label="Styled" id="styled">
			<svg height="16" viewBox="0 0 10 10" width="16">
				<style is:inline>
					.styled-fill {
						fill: url('#styled-paint');
					}
				</style>
				<linearGradient id="styled-paint">
					<stop stop-color="#00ff00"></stop>
				</linearGradient>
				<rect class="styled-fill" height="10" width="10"></rect>
			</svg>
		</sonic-key>
		<sonic-key aria-label="Encoded" id="encoded">
			<svg height="16" viewBox="0 0 10 10" width="16">
				<linearGradient id="encoded-paint">
					<stop stop-color="#00ff00"></stop>
				</linearGradient>
				<rect fill="URL(#encoded-p%61int)" height="10" width="10"></rect>
			</svg>
		</sonic-key>
		<svg height="16" id="encoded-twin" viewBox="0 0 10 10" width="16">
			<linearGradient id="encoded-paint">
				<stop stop-color="#00ff00"></stop>
			</linearGradient>
			<rect fill="URL(#encoded-p%61int)" height="10" width="10"></rect>
		</svg>
		<sonic-key id="worded">Go</sonic-key>
	</main>
	<script>
		import '@xsynaptic/sonic-ui/define/key';
	</script>
</Document>
