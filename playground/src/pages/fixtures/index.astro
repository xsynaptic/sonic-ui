---
import Play from '@lucide/astro/icons/play';

import Document from '#components/document.astro';
import { echoModes } from '#scripts/stop-names.ts';
import '#styles/playground.css';
---

<Document bodyClass="bg-zinc-950 text-zinc-300" title="sonic-ui fixtures">
	<main class="flex flex-wrap items-center gap-16 p-16">
		<h1 class="sr-only">Fixtures</h1>
		<div class="grid justify-items-center gap-2">
			<sonic-dial
				aria-labelledby="level-label"
				default="20"
				id="level"
				readout
				value="50"
			></sonic-dial>
			<span id="level-label">Level</span>
		</div>
		<div class="grid justify-items-center gap-2">
			<sonic-dial
				aria-labelledby="cutoff-label"
				data-format="hertz"
				id="cutoff"
				max="20000"
				min="20"
				value="1000"
			></sonic-dial>
			<span id="cutoff-label">Cutoff</span>
		</div>
		<sonic-dial aria-label="Phase" endless id="phase" max="360" step="5" value="350"></sonic-dial>
		<sonic-dial
			aria-label="Low"
			detent="0"
			id="eq"
			max="6"
			min="-30"
			origin="0"
			value="-3"
		></sonic-dial>
		<sonic-dial
			aria-label="Locked"
			disabled
			id="locked"
			modulation="20"
			notched
			step="10"
			value="30"
		></sonic-dial>
		<sonic-dial
			aria-label="Echo mode"
			class="[--sonic-dial-scale-font-ratio:0.085] [--sonic-dial-scale-ratio:0.34] [--sonic-dial-size:6rem] [--sonic-dial-sweep:180deg]"
			data-format="echo-mode"
			id="selector"
			max="3"
			notched
			value="1"
		>
			{echoModes.labels.map((mode, index) => (
				<span data-sonic-value={index}>{mode}</span>
			))}
		</sonic-dial>
		<sonic-slider aria-label="Send" default="50" id="send" value="0"></sonic-slider>
		<sonic-slider
			aria-label="Trim"
			class="[--sonic-slider-size:3.25rem]"
			id="scaled"
			max="10"
			min="-20"
			orientation="vertical"
			value="0"
		>
			<span data-sonic-value="10">+10</span>
			<span data-sonic-value="0"></span>
			<span data-sonic-value="-20">−20</span>
		</sonic-slider>
		<sonic-slider
			aria-label="Crossfade"
			default="50"
			double-press="reset"
			groove-press="none"
			id="crossfader"
			value="20"
		></sonic-slider>
		<sonic-slider
			aria-label="Fader"
			id="fader"
			modulation="20"
			orientation="vertical"
			value="0"
		></sonic-slider>
		<sonic-slider
			aria-label="Bend"
			id="bend"
			max="50"
			min="-50"
			origin="0"
			spring
			value="0"
		></sonic-slider>
		<sonic-slider
			aria-label="Progress"
			data-buffered="0 40 60 80"
			id="progress"
			value="20"
		></sonic-slider>
		<div class="w-72" id="strip-box">
			<sonic-slider
				aria-label="Seek"
				class="[--sonic-slider-cap-ratio:0] [--sonic-slider-length:100%] [--sonic-slider-size:1rem]"
				id="strip"
				key-step="5"
				max="300"
				readout
				step="0"
			></sonic-slider>
		</div>
		<div class="grid justify-items-center gap-2">
			<sonic-number
				aria-labelledby="tempo-label"
				id="tempo"
				max="300"
				min="20"
				step="0.5"
				value="120"
			></sonic-number>
			<span id="tempo-label">Tempo</span>
		</div>
		<sonic-button aria-label="Mute" id="mute" latching>
			<Play aria-hidden="true" />
		</sonic-button>
		<sonic-button aria-label="Kick" id="kick" momentary></sonic-button>
		<sonic-button aria-label="Play" busy id="loading">
			<Play aria-hidden="true" />
		</sonic-button>
		<sonic-button aria-label="Next" id="next">
			<Play aria-hidden="true" />
		</sonic-button>
		<sonic-button aria-label="Power" id="power" latching>
			<span class="sonic-led"></span>
		</sonic-button>
		<span class="sonic-led" id="led"></span>
		<span class="sonic-led" data-sonic-lit id="led-lit"></span>
		<span class="sonic-led" data-sonic-lit="alt" id="led-alt"></span>
		<sonic-segmented aria-label="Mode" id="mode" value="lp">
			<span data-sonic-value="lp">LP</span>
			<span data-sonic-value="hp">HP</span>
		</sonic-segmented>
		<sonic-switch aria-label="Talk" id="talk" value="off">
			<span data-sonic-momentary data-sonic-value="duck">
				Duck
			</span>
			<span data-sonic-value="off">Off</span>
			<span data-sonic-value="on">On</span>
		</sonic-switch>
		<sonic-switch aria-label="Sync" id="sync"></sonic-switch>
		<section aria-label="Panel" class="sonic-panel p-4" id="panel">
			<h2 class="sonic-panel-title">Panel</h2>
		</section>
		<sonic-meter id="meter" max="0" min="-60"></sonic-meter>
		<sonic-meter id="ladder" segments="-24 -12 -6 -3 0"></sonic-meter>
		<sonic-meter
			id="correlation"
			max="1"
			min="-1"
			orientation="horizontal"
			origin="0"
			value="0"
		></sonic-meter>
		<div class="sonic-screen" id="screen">
			440 Hz
		</div>
		<div class="w-72" id="wavestrip-box">
			<sonic-wavestrip
				aria-label="Position"
				cancellable
				class="[--sonic-wavestrip-length:100%]"
				data-markers="60 62 150..180:loop 240~"
				data-peaks="flat"
				id="wavestrip"
				max="300"
				readout
				step="0"
				value="150"
			></sonic-wavestrip>
		</div>
		<div class="w-72" id="waveform-box">
			<sonic-waveform
				aria-label="Detail"
				class="[--sonic-waveform-length:100%]"
				data-markers="148 151~"
				data-samples="3"
				id="waveform"
				max="300"
				readout
				step="0"
				value="150"
			></sonic-waveform>
		</div>
		<sonic-slider
			aria-label="Pitch"
			default="0"
			id="rest"
			max="8"
			min="-8"
			origin="0"
			step="0.1"
			value="0"
		>
			<span class="sonic-led"></span>
		</sonic-slider>
		<sonic-button aria-label="Cue" armed id="armed" latching>
			<Play aria-hidden="true" />
		</sonic-button>
		<sonic-button aria-label="Loop" armed id="armed-led" latching>
			<span class="sonic-led"></span>
		</sonic-button>
		<span class="sonic-led" data-sonic-lit="dim" id="led-dim"></span>
		<span class="sonic-led" data-sonic-lit="hot" id="led-hot"></span>
		<span class="sonic-led" data-sonic-lit="clip" id="led-clip"></span>
		<sonic-dial aria-label="Wobble" id="modulated" max="120" min="20" value="40"></sonic-dial>
		<sonic-slider
			aria-label="Sweep"
			id="modulated-slider"
			max="120"
			min="20"
			value="40"
		></sonic-slider>
		<span
			aria-label="Import"
			aria-valuenow="40"
			class="sonic-ring"
			id="ring"
			role="progressbar"
			style="

--sonic-ring-to: 0.4"
		></span>
		<span
			class="sonic-ring"
			id="ring-button"
			style="

--sonic-ring-from: 0.25; --sonic-ring-to: 0.5"
		>
			<sonic-button aria-label="Loop position" latching>
				<Play aria-hidden="true" />
			</sonic-button>
		</span>
		<sonic-xy aria-label="Pad" id="xy" x="50" y="50"></sonic-xy>
		<sonic-xy
			aria-label="Filter"
			id="xy-log"
			readout
			x="1000"
			x-label="Cutoff"
			x-max="20000"
			x-min="20"
			x-origin="1000"
			x-taper="log"
			y="6"
			y-label="Resonance"
			y-max="24"
			y-min="-24"
			y-origin="0"
			y-step="0.5"
		></sonic-xy>
		<sonic-xy aria-label="Locked XY pad" disabled id="xy-disabled" x="30" y="70"></sonic-xy>
		<sonic-envelope
			attack="env-attack"
			decay="env-decay"
			id="envelope"
			release="env-release"
			sustain="env-sustain"
		></sonic-envelope>
		<sonic-dial
			aria-label="Envelope attack"
			id="env-attack"
			max="2000"
			min="1"
			taper="log"
			value="45"
		></sonic-dial>
		<sonic-dial
			aria-label="Envelope decay"
			id="env-decay"
			max="2000"
			min="1"
			taper="log"
			value="45"
		></sonic-dial>
		<sonic-dial
			aria-label="Envelope sustain"
			id="env-sustain"
			max="1"
			step="0.01"
			value="0.6"
		></sonic-dial>
		<sonic-dial
			aria-label="Envelope release"
			id="env-release"
			max="5000"
			min="1"
			taper="log"
			value="71"
		></sonic-dial>
		<sonic-envelope
			attack="env-attack"
			attack-curve="env-attack-curve"
			decay="env-decay"
			decay-curve="env-decay-curve"
			id="envelope-curves"
			readout
			release="env-release"
			sustain="env-sustain"
		></sonic-envelope>
		<sonic-dial
			aria-label="Envelope attack curve"
			id="env-attack-curve"
			max="8"
			min="-8"
			step="0.5"
			value="-3"
		></sonic-dial>
		<sonic-dial
			aria-label="Envelope decay curve"
			id="env-decay-curve"
			max="8"
			min="-8"
			step="0.5"
			value="3"
		></sonic-dial>
		<sonic-split aria-label="Split" class="grid gap-16" id="split">
			<sonic-slider aria-label="Split A" id="split-a" step="5" value="50"></sonic-slider>
			<sonic-slider aria-label="Split B" id="split-b" min="10" step="5" value="30"></sonic-slider>
			<sonic-slider aria-label="Split C" id="split-c" step="5" value="20"></sonic-slider>
		</sonic-split>
		<sonic-split aria-label="Locked split" class="grid gap-16" id="split-locked">
			<sonic-slider aria-label="Locked A" id="locked-a" value="50"></sonic-slider>
			<sonic-slider aria-label="Locked B" data-sonic-locked id="locked-b" value="30"></sonic-slider>
			<sonic-slider aria-label="Locked C" id="locked-c" value="20"></sonic-slider>
		</sonic-split>
	</main>
	<script>
		import '@xsynaptic/sonic-ui/define';

		import '#scripts/formats.ts';
		import '#scripts/buffered.ts';
		import '#scripts/samples.ts';
		import '#scripts/markers.ts';
		import '#scripts/peaks.ts';
	</script>
</Document>
