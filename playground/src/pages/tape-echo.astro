---
import Layout from '#components/layout.astro';
import PageHeader from '#components/page-header.astro';
import EchoPanel from '#components/tape-echo/echo-panel.astro';
import TempoPanel from '#components/tape-echo/tempo-panel.astro';
import TonePanel from '#components/tape-echo/tone-panel.astro';
---

<Layout
	description="A two-head tape echo on Web Audio, built from sonic-ui controls."
	title="Tape echo, sonic-ui"
>
	<PageHeader title="Tape echo">
		<Fragment slot="lead">
			A two-head tape echo running on Web Audio. Press Play to hear a phrase through it.
		</Fragment>
	</PageHeader>
	<div class="-mx-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0" data-tape-echo>
		<div class="inline-grid min-w-max gap-4 surface p-4">
			<div class="flex items-stretch gap-4">
				<EchoPanel />
				<TempoPanel />
				<TonePanel />
			</div>
			<div class="grid grid-cols-[minmax(0,1fr)_9rem] items-center gap-4">
				<sonic-spectrum
					class="[--sonic-spectrum-clip-from:-25] [--sonic-spectrum-hot-from:-34] [--sonic-spectrum-length:100%]"
					data-echo-spectrum
				></sonic-spectrum>
				<div class="grid justify-items-center gap-2 font-mono">
					<sonic-button aria-label="Read peak" class="text-[0.5rem]" data-echo-peak-read>
						<span aria-hidden="true">PEAK</span>
					</sonic-button>
					<p class="min-h-4 text-[0.625rem] text-text" data-echo-peak-status role="status"></p>
				</div>
			</div>
		</div>
	</div>
	<Fragment slot="scripts">
		<script>
			import '#scripts/tape-echo/tape-echo.ts';
		</script>
	</Fragment>
</Layout>
