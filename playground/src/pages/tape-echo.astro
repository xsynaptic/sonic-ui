---
import Ghost from '#components/ghost.astro';
import Layout from '#components/layout.astro';
import PageHeader from '#components/page-header.astro';
import PanelButton from '#components/replica/panel-button.astro';
import EchoPanel from '#components/tape-echo/echo-panel.astro';
import TempoPanel from '#components/tape-echo/tempo-panel.astro';
import TonePanel from '#components/tape-echo/tone-panel.astro';
---

<Layout
	description="A two-head tape echo on Web Audio, built from sonic-ui controls."
	title="Tape echo, sonic-ui"
>
	<PageHeader title="Tape echo">
		<Fragment slot="lead">
			A two-head tape echo running on Web Audio. Press Play to hear a phrase through it. A dashed
			edge marks a part the library does not have yet.
		</Fragment>
		<ul
			class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-text-muted first:[&>li]:text-text-strong"
			data-ghost-tally
		></ul>
	</PageHeader>
	<div class="-mx-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0" data-tape-echo>
		<div class="mb-4 flex">
			<PanelButton
				data={{ 'data-echo-play': '' }}
				id="echo-play"
				isRound={true}
				label="Play"
				size="large"
			/>
		</div>
		<div class="inline-grid min-w-max gap-4 surface p-4">
			<div class="flex items-stretch gap-4">
				<EchoPanel />
				<TempoPanel />
				<TonePanel />
			</div>
			<Ghost blockSize="6rem" inlineSize="100%" name="Step grid" />
		</div>
	</div>
	<Fragment slot="scripts">
		<script>
			import '#scripts/ghost-tally.ts';
			import '#scripts/tape-echo/tape-echo.ts';
		</script>
	</Fragment>
</Layout>
