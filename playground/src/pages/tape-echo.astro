---
import Ghost from '#components/ghost.astro';
import Layout from '#components/layout.astro';
import PanelKey from '#components/replica/panel-key.astro';
import EchoPlate from '#components/tape-echo/echo-plate.astro';
import TempoPlate from '#components/tape-echo/tempo-plate.astro';
import TonePlate from '#components/tape-echo/tone-plate.astro';
---

<Layout title="sonic-ui, tape echo">
	<header class="mb-6 max-w-2xl">
		<h1 class="font-mono text-xs font-bold tracking-[0.12em] text-zinc-200 uppercase">Tape echo</h1>
		<p class="mt-3 text-sm leading-relaxed text-zinc-400">
			A two-head tape echo on Web Audio. Press Play to hear a phrase through it. Dashed outlines
			mark parts the library doesn't have yet.
		</p>
		<ul
			class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-zinc-400 first:[&>li]:text-zinc-200"
			data-ghost-tally
		></ul>
	</header>
	<div class="-mx-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0" data-tape-echo>
		<div class="mb-4 flex">
			<PanelKey
				data={{ 'data-echo-play': '' }}
				id="echo-play"
				isRound={true}
				label="Play"
				size="large"
			/>
		</div>
		<div class="inline-grid min-w-max gap-4 rounded-lg border border-zinc-800 bg-zinc-900 p-4 shadow-[inset_0_1px_0_rgb(255_255_255/4%)]">
			<div class="flex items-stretch gap-4">
				<EchoPlate />
				<TempoPlate />
				<TonePlate />
			</div>
			<Ghost blockSize="6rem" inlineSize="100%" name="Step grid" />
		</div>
	</div>
	<Fragment slot="scripts">
		<script>
			import '#scripts/ghost-tally.ts';
			import '#scripts/tape-echo/tape-echo.ts';
		</script>
	</Fragment>
</Layout>
