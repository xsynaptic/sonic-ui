---
import Layout from '#components/layout.astro';
import PageHeader from '#components/page-header.astro';
import TapeEcho from '#components/tape-echo/tape-echo.astro';
---

<Layout
	description="A two-head tape echo on Web Audio, built from sonic-ui controls."
	title="Tape echo, sonic-ui"
>
	<PageHeader title="Tape echo">
		<Fragment slot="lead">
			A two-head tape echo running on Web Audio. Press Play to hear it on one of three sources: a
			built-in phrase, your microphone, or an audio file you choose or drop on the panel. The audio
			never leaves the browser.
		</Fragment>
	</PageHeader>
	<TapeEcho />
	<Fragment slot="scripts">
		<script>
			import '#scripts/tape-echo/tape-echo.ts';
		</script>
	</Fragment>
</Layout>
