---
import Crossfader from '#components/club-mixer/crossfader.astro';
import FilterSection from '#components/club-mixer/filter-section.astro';
import MasterPanel from '#components/club-mixer/master-panel.astro';
import MicChannel from '#components/club-mixer/mic-channel.astro';
import MusicChannel from '#components/club-mixer/music-channel.astro';
import Layout from '#components/layout.astro';
import PageHeader from '#components/page-header.astro';

const channels = [
	{ channel: 1, fader: 0, level: 0 },
	{ channel: 2, fader: -4, level: -2 },
	{ channel: 3, fader: -9, level: 3 },
	{ channel: 4, fader: -60, level: 0 },
];
---

<Layout
	description="A four-channel club mixer built from sonic-ui dials, sliders, switches and meters."
	title="Club mixer, sonic-ui"
>
	<PageHeader title="Club mixer">
		<Fragment slot="lead">
			Four music channels, two mic channels and two filters. Press Start to run a demo signal
			through the meters.
		</Fragment>
	</PageHeader>
	<div class="-mx-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0">
		<div
			class="inline-flex min-w-max items-stretch surface p-4 [--sonic-meter-clip-from:-4] [--sonic-meter-hot-from:-10]"
			data-club-mixer
		>
			<div class="sonic-panel flex p-1 pb-3 [--sonic-panel-depth:0px]">
				<MicChannel channel={1} fader={-6} />
				<MicChannel channel={2} fader={-60} />
			</div>
			<FilterSection filter={1} />
			<div class="flex flex-col">
				<div class="flex flex-1">
					{channels.map((strip) => (
						<MusicChannel {...strip} />
					))}
				</div>
				<Crossfader />
			</div>
			<FilterSection filter={2} />
			<MasterPanel />
		</div>
	</div>
	<Fragment slot="scripts">
		<script>
			import '#scripts/club-mixer/club-mixer.ts';
			import '#scripts/two-colour.ts';
		</script>
	</Fragment>
</Layout>
