---
import LandingTiles from '#components/landing-tiles.astro';
import Layout from '#components/layout.astro';
import RunButton from '#components/run-button.astro';
import Wordmark from '#components/wordmark.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const demos = [
	{
		href: `${base}/club-mixer/`,
		label: 'Club mixer',
		lead: 'Four music channels, two mics, two filters',
	},
	{ href: `${base}/tape-echo/`, label: 'Tape echo', lead: 'A two-head echo on Web Audio' },
	{ href: `${base}/web-player/`, label: 'Web player', lead: 'A docked bar on a simulated stream' },
	{ href: `${base}/tokens/`, label: 'Tokens', lead: 'See what each token does to a control' },
];
---

<Layout
	description="Native custom elements for audio interfaces: dials, sliders, meters, waveforms and more, skinned with tokens."
	title="sonic-ui"
>
	<RunButton slot="controls" />
	<header class="mb-10 grid justify-items-start gap-5">
		<h1 class="text-[clamp(2.75rem,13vw,6rem)] leading-none text-text-strong">
			<Wordmark />
		</h1>
		<p class="max-w-2xl text-lg leading-relaxed text-text-muted">
			Native custom elements for audio interfaces: dials, sliders, meters, waveforms and more,
			skinned with tokens. Every tile below is live: drag one, press one, or open its page for the
			rest.
		</p>
		<pre class="rounded bg-surface px-3 py-2 font-mono text-[0.8125rem] text-text">pnpm add @xsynaptic/sonic-ui</pre>
		<ul aria-label="Demos" class="flex flex-wrap gap-3">
			{demos.map((demo) => (
				<li>
					<a class="grid gap-0.5 surface px-4 py-3 hover:border-line-strong" href={demo.href}>
						<span class="font-mono text-xs font-bold tracking-[0.12em] text-text-strong uppercase">
							{demo.label}
						</span>
						<span class="text-sm text-text-muted">{demo.lead}</span>
					</a>
				</li>
			))}
		</ul>
	</header>
	<LandingTiles />
</Layout>
