---
import DialDemos from '#components/dial-demos.astro';
import KeyDemos from '#components/key-demos.astro';
import Layout from '#components/layout.astro';
import LedDemos from '#components/led-demos.astro';
import MeterDemos from '#components/meter-demos.astro';
import NumberDemos from '#components/number-demos.astro';
import ScreenDemos from '#components/screen-demos.astro';
import Section from '#components/section.astro';
import SliderDemos from '#components/slider-demos.astro';
import SwitchDemos from '#components/switch-demos.astro';
import Tuner from '#components/tuner.astro';
---

<Layout title="sonic-ui">
	<header class="mb-8 max-w-2xl">
		<p class="text-sm leading-relaxed text-zinc-400">
			Native custom elements for audio interfaces, skinned with CSS custom properties.
		</p>
		<pre class="mt-3 inline-block bg-zinc-900 px-3 py-2 font-mono text-[0.8125rem] text-zinc-300">pnpm add @xsynaptic/sonic-ui</pre>
	</header>
	<Section id="tuner" title="Tuner">
		<Tuner />
	</Section>
	<Section id="dial" title="Dial">
		<DialDemos />
	</Section>
	<Section id="slider" title="Slider">
		<SliderDemos />
	</Section>
	<Section id="key" title="Key">
		<KeyDemos />
	</Section>
	<Section id="led" title="LED">
		<LedDemos />
	</Section>
	<Section id="switch" title="Switch">
		<SwitchDemos />
	</Section>
	<Section id="number" title="Number">
		<NumberDemos />
	</Section>
	<Section id="meter" title="Meter">
		<MeterDemos />
	</Section>
	<Section id="screen" title="Screen">
		<ScreenDemos />
	</Section>
</Layout>
