---
import Layout from '#components/layout.astro';
import PageHeader from '#components/page-header.astro';
import ButtonSpecimens from '#components/specimens/button.astro';
import DialSpecimens from '#components/specimens/dial.astro';
import EnvelopeSpecimens from '#components/specimens/envelope.astro';
import LedSpecimens from '#components/specimens/led.astro';
import MeterSpecimens from '#components/specimens/meter.astro';
import NumberSpecimens from '#components/specimens/number.astro';
import PanelSpecimens from '#components/specimens/panel.astro';
import RingSpecimens from '#components/specimens/ring.astro';
import ScreenSpecimens from '#components/specimens/screen.astro';
import Section from '#components/specimens/section.astro';
import SegmentedSpecimens from '#components/specimens/segmented.astro';
import SliderSpecimens from '#components/specimens/slider.astro';
import SplitSpecimens from '#components/specimens/split.astro';
import SwitchSpecimens from '#components/specimens/switch.astro';
import Tuner from '#components/specimens/tuner.astro';
import WaveformSpecimens from '#components/specimens/waveform.astro';
import WavestripSpecimens from '#components/specimens/wavestrip.astro';
import XySpecimens from '#components/specimens/xy.astro';

const sections = [
	{ id: 'tuner', label: 'Tuner' },
	{ id: 'dial', label: 'Dial' },
	{ id: 'slider', label: 'Slider' },
	{ id: 'number', label: 'Number box' },
	{ id: 'xy', label: 'XY pad' },
	{ id: 'envelope', label: 'Envelope' },
	{ id: 'split', label: 'Split' },
	{ id: 'button', label: 'Button' },
	{ id: 'segmented', label: 'Segmented' },
	{ id: 'switch', label: 'Switch' },
	{ id: 'led', label: 'LED' },
	{ id: 'ring', label: 'Ring' },
	{ id: 'meter', label: 'Meter' },
	{ id: 'screen', label: 'Screen' },
	{ id: 'wavestrip', label: 'Wavestrip' },
	{ id: 'waveform', label: 'Waveform' },
	{ id: 'panel', label: 'Panel' },
];
---

<Layout
	description="Native custom elements for audio interfaces: dials, sliders, meters, waveforms and more, skinned with tokens."
	title="sonic-ui"
>
	<PageHeader title="Specimens">
		<Fragment slot="lead">
			Native custom elements for audio interfaces. Every control and display is here to try: drag,
			press, or focus one and use the keyboard. Pick a skin and a colour scheme above, or set tokens
			live in the tuner.
		</Fragment>
		<pre class="mt-4 inline-block rounded bg-surface px-3 py-2 font-mono text-[0.8125rem] text-text">pnpm add @xsynaptic/sonic-ui</pre>
	</PageHeader>
	<nav aria-label="Contents" class="mb-10">
		<ul class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs">
			{sections.map((section) => (
				<li>
					<a
						class="inline-flex min-h-6 items-center text-text-muted underline-offset-4 hover:text-text-strong hover:underline"
						href={`#${section.id}`}
					>
						{section.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
	<Section id="tuner" title="Tuner">
		<Tuner />
	</Section>
	<Section id="dial" title="Dial">
		<DialSpecimens />
	</Section>
	<Section id="slider" title="Slider">
		<SliderSpecimens />
	</Section>
	<Section id="number" title="Number box">
		<NumberSpecimens />
	</Section>
	<Section id="xy" title="XY pad">
		<XySpecimens />
	</Section>
	<Section id="envelope" title="Envelope">
		<EnvelopeSpecimens />
	</Section>
	<Section id="split" title="Split">
		<SplitSpecimens />
	</Section>
	<Section id="button" title="Button">
		<ButtonSpecimens />
	</Section>
	<Section id="segmented" title="Segmented">
		<SegmentedSpecimens />
	</Section>
	<Section id="switch" title="Switch">
		<SwitchSpecimens />
	</Section>
	<Section id="led" title="LED">
		<LedSpecimens />
	</Section>
	<Section id="ring" title="Ring">
		<RingSpecimens />
	</Section>
	<Section id="meter" title="Meter">
		<MeterSpecimens />
	</Section>
	<Section id="screen" title="Screen">
		<ScreenSpecimens />
	</Section>
	<Section id="wavestrip" title="Wavestrip">
		<WavestripSpecimens />
	</Section>
	<Section id="waveform" title="Waveform">
		<WaveformSpecimens />
	</Section>
	<Section id="panel" title="Panel">
		<PanelSpecimens />
	</Section>
	<Fragment slot="scripts">
		<script>
			import '#scripts/specimens/motion.ts';
			import '#scripts/specimens/xy.ts';
			import '#scripts/specimens/screen-follow.ts';
			import '#scripts/specimens/split.ts';
			import '#scripts/specimens/zoom.ts';
			import '#scripts/buffered.ts';
			import '#scripts/samples.ts';
			import '#scripts/markers.ts';
			import '#scripts/peaks.ts';
			import '#scripts/specimens/tuner.ts';
			import '#scripts/two-colour.ts';
		</script>
	</Fragment>
</Layout>
