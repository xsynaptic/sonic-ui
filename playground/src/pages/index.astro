---
import Layout from '#components/layout.astro';
import DialSpecimens from '#components/specimens/dial.astro';
import KeySpecimens from '#components/specimens/key.astro';
import LedSpecimens from '#components/specimens/led.astro';
import LeverSpecimens from '#components/specimens/lever.astro';
import MeterSpecimens from '#components/specimens/meter.astro';
import NumberSpecimens from '#components/specimens/number.astro';
import PlateSpecimens from '#components/specimens/plate.astro';
import ScreenSpecimens from '#components/specimens/screen.astro';
import Section from '#components/specimens/section.astro';
import SliderSpecimens from '#components/specimens/slider.astro';
import SwitchSpecimens from '#components/specimens/switch.astro';
import Tuner from '#components/specimens/tuner.astro';

const sections = [
	{ id: 'tuner', label: 'Tuner' },
	{ id: 'dial', label: 'Dial' },
	{ id: 'slider', label: 'Slider' },
	{ id: 'key', label: 'Key' },
	{ id: 'led', label: 'LED' },
	{ id: 'switch', label: 'Switch' },
	{ id: 'lever', label: 'Lever' },
	{ id: 'number', label: 'Number' },
	{ id: 'meter', label: 'Meter' },
	{ id: 'screen', label: 'Screen' },
	{ id: 'plate', label: 'Plate' },
];
---

<Layout sections={sections} title="sonic-ui">
	<header class="mb-8 max-w-2xl">
		<p class="text-sm leading-relaxed text-zinc-400">
			Native custom elements for audio interfaces, skinned with CSS custom properties.
		</p>
		<pre class="mt-3 inline-block bg-zinc-900 px-3 py-2 font-mono text-[0.8125rem] text-zinc-300">pnpm add @xsynaptic/sonic-ui</pre>
	</header>
	<Section id="tuner" title="Tuner">
		<Tuner />
	</Section>
	<Section id="dial" title="Dial">
		<DialSpecimens />
	</Section>
	<Section id="slider" title="Slider">
		<SliderSpecimens />
	</Section>
	<Section id="key" title="Key">
		<KeySpecimens />
	</Section>
	<Section id="led" title="LED">
		<LedSpecimens />
	</Section>
	<Section id="switch" title="Switch">
		<SwitchSpecimens />
	</Section>
	<Section id="lever" title="Lever">
		<LeverSpecimens />
	</Section>
	<Section id="number" title="Number">
		<NumberSpecimens />
	</Section>
	<Section id="meter" title="Meter">
		<MeterSpecimens />
	</Section>
	<Section id="screen" title="Screen">
		<ScreenSpecimens />
	</Section>
	<Section id="plate" title="Plate">
		<PlateSpecimens />
	</Section>
	<Fragment slot="scripts">
		<script>
			import '#scripts/specimens/motion.ts';
			import '#scripts/specimens/screen-follow.ts';
			import '#scripts/buffered.ts';
			import '#scripts/specimens/tuner.ts';
			import '#scripts/two-colour.ts';
		</script>
	</Fragment>
</Layout>
