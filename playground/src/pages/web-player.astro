---
import AudioWaveform from '@lucide/astro/icons/audio-waveform';
import Pause from '@lucide/astro/icons/pause';
import Play from '@lucide/astro/icons/play';
import RotateCcw from '@lucide/astro/icons/rotate-ccw';
import RotateCw from '@lucide/astro/icons/rotate-cw';
import SkipBack from '@lucide/astro/icons/skip-back';
import SkipForward from '@lucide/astro/icons/skip-forward';
import Volume2 from '@lucide/astro/icons/volume-2';
import VolumeX from '@lucide/astro/icons/volume-x';
import ZoomIn from '@lucide/astro/icons/zoom-in';
import ZoomOut from '@lucide/astro/icons/zoom-out';

import Layout from '#components/layout.astro';
import PageHeader from '#components/page-header.astro';
---

<Layout
	description="A docked player bar on a simulated stream, built from sonic-ui controls."
	title="Web player, sonic-ui"
>
	<PageHeader title="Web player">
		<Fragment slot="lead">
			A docked player bar on a simulated stream. Scrub past the loaded range to see it buffer, then
			open the waveform to watch its peaks arrive.
		</Fragment>
	</PageHeader>
	<div class="flex min-h-80 flex-col surface p-3">
		<div class="flex-1"></div>
		<section
			aria-label="Player"
			class="sonic-panel @container relative [--sonic-marker-intro:oklch(72%_0.13_200deg)] [--sonic-dial-size:2rem] [--sonic-button-size:2rem]"
			data-web-player
		>
			<div class="relative border-b border-line p-2" data-panel hidden>
				<sonic-waveform
					aria-label="Waveform"
					class="[--sonic-waveform-length:100%] [--sonic-waveform-size:7.5rem]"
					data-detail
					disabled
					key-step="1"
					max="1"
					readout
					step="0"
				></sonic-waveform>
				<div class="absolute top-4 right-4 flex gap-1 [--sonic-button-size:1.5rem]">
					<sonic-button aria-label="Zoom out" data-zoom="-1">
						<ZoomOut aria-hidden="true" />
					</sonic-button>
					<sonic-button aria-label="Zoom in" data-zoom="1">
						<ZoomIn aria-hidden="true" />
					</sonic-button>
				</div>
			</div>
			<div class="px-4 pt-3">
				<sonic-slider
					aria-label="Seek"
					class="[--sonic-slider-cap-ratio:0] [--sonic-slider-groove-ratio:0.35] [--sonic-slider-length:100%] [--sonic-slider-size:1rem]"
					data-seek
					disabled
					key-step="5"
					max="1"
					readout
					step="0"
				></sonic-slider>
			</div>
			<div class="flex flex-wrap items-center gap-x-4 gap-y-3 px-4 py-3">
				<div class="flex items-center gap-1">
					<sonic-button aria-label="Previous" data-previous soft-disabled>
						<SkipBack aria-hidden="true" />
					</sonic-button>
					<sonic-button aria-label="Back 10 seconds" data-seek-by="-10" disabled>
						<RotateCcw aria-hidden="true" />
					</sonic-button>
					<sonic-button
						aria-label="Play"
						class="[--sonic-button-face-radius-ratio:0.5] [--sonic-button-radius-ratio:0.5] [--sonic-button-size:2.5rem]"
						data-play
						latching
					>
						<Play aria-hidden="true" data-sonic-when="released" />
						<Pause aria-hidden="true" data-sonic-when="pressed" />
					</sonic-button>
					<sonic-button aria-label="Forward 10 seconds" data-seek-by="10" disabled>
						<RotateCw aria-hidden="true" />
					</sonic-button>
					<sonic-button aria-label="Next" data-next soft-disabled>
						<SkipForward aria-hidden="true" />
					</sonic-button>
				</div>
				<div class="flex min-w-40 flex-1 items-center gap-3">
					<div class="grid min-w-0 flex-1 leading-tight">
						<p class="truncate text-sm text-text-strong" data-title></p>
						<p class="truncate text-xs text-text-muted" data-artist></p>
					</div>
					<button
						aria-label="Remaining time"
						aria-pressed="false"
						class="sonic-screen cursor-pointer font-mono text-xs tabular-nums [--sonic-screen-aspect-ratio:3] [--sonic-screen-size:1.5rem] [text-shadow:0_0_0.4em_currentColor] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text disabled:cursor-default disabled:opacity-60"
						data-time
						disabled
						type="button"
					>
						--:--
					</button>
				</div>
				<sonic-segmented aria-label="Playback rate" class="font-mono text-xs" data-rate value="1">
					<span data-sonic-value="1">1×</span>
					<span data-sonic-value="1.5">1.5×</span>
					<span data-sonic-value="2">2×</span>
				</sonic-segmented>
				<sonic-button aria-label="Show waveform" data-panel-button disabled latching>
					<AudioWaveform aria-hidden="true" />
				</sonic-button>
				<div class="flex items-center gap-2">
					<sonic-button aria-label="Mute" data-mute latching>
						<Volume2 aria-hidden="true" data-sonic-when="released" />
						<VolumeX aria-hidden="true" data-sonic-when="pressed" />
					</sonic-button>
					<sonic-dial
						aria-label="Volume"
						data-volume
						max="1"
						readout
						step="0.01"
						value="0.8"
					></sonic-dial>
				</div>
				<div class="basis-full">
					<sonic-wavestrip
						aria-label="Wavestrip"
						cancellable
						class="[--sonic-wavestrip-length:100%]"
						data-wave
						disabled
						key-step="5"
						max="1"
						readout
						step="0"
					></sonic-wavestrip>
				</div>
			</div>
		</section>
	</div>
	<Fragment slot="scripts">
		<script>
			import '#scripts/web-player/web-player.ts';
		</script>
	</Fragment>
</Layout>
